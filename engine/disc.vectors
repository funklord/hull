# root: the root's record as the descriptor holds it, 34 bytes, its identifier the byte 0
root_record root 22 00 14 00 00 00 00 00 00 14 00 08 00 00 00 00 08 00 50 01 01 00 00 00 00 02 00 00 01 00 00 01 01 00

# dot: the root's own `.`, 34 bytes
directory_record dot 22 00 14 00 00 00 00 00 00 14 00 08 00 00 00 00 08 00 50 01 01 00 00 00 00 02 00 00 01 00 00 01 01 00

# subdir: DATA, a directory, its identifier 4 bytes and so no pad
directory_record subdir 26 00 15 00 00 00 00 00 00 15 00 08 00 00 00 00 08 00 50 01 01 00 00 00 00 02 00 00 01 00 00 01 04 44 41 54 41 00

# file: README.TXT;1, a file of 12 bytes and its pad to an even length
directory_record file 2E 00 1B 00 00 00 00 00 00 1B 03 00 00 00 00 00 00 03 50 01 01 00 00 00 00 00 00 00 01 00 00 01 0C 52 45 41 44 4D 45 2E 54 58 54 3B 31 00

# l_root: the L path table's root: identifier 0, its own parent 1
path_entry l_root 01 00 14 00 00 00 01 00 00

# m_root: the M path table's root, big-endian
path_entry_big m_root 01 00 00 00 00 14 00 01 00
