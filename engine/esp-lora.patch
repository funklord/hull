+static void esp32s3_machine_init_lora(Esp32s3MachineState *ms, Esp32s3SocState *ss)
+{
+    bool sx1262 = ms->lora_chip && strcmp(ms->lora_chip, "sx1262") == 0;
+    /* An SX1262's as a Heltec WiFi LoRa 32 V3 wires it, BUSY the fourth. */
+    unsigned nss = sx1262 ? 8 : 7, nreset = sx1262 ? 12 : 8, dio = sx1262 ? 14 : 9;
+    unsigned busy = 13;
+    Chardev *air = qemu_chr_find(ms->lora);
+    DeviceState *radio;
+    BusState *bus = qdev_get_child_bus(DEVICE(&ss->gpspi2), "spi");
+
+    if (!air) {
+        error_report("lora: no chardev %s", ms->lora);
+        exit(1);
+    }
+    if (ms->lora_chip && !sx1262 && strcmp(ms->lora_chip, "sx1276") != 0) {
+        error_report("lora-chip: sx1276 or sx1262");
+        exit(1);
+    }
+    if (ms->lora_pins &&
+        (sscanf(ms->lora_pins, "%u:%u:%u:%u", &nss, &nreset, &dio, &busy) < 3 ||
+         nss > 31 || nreset > 31 || dio > 31 || busy > 31)) {
+        error_report("lora-pins: NSS:NRESET:DIO[:BUSY], each a GPIO below 32");
+        exit(1);
+    }
+    radio = qdev_new(sx1262 ? "sx126x" : "sx127x");
+    qdev_prop_set_chr(radio, "chardev", air);
+    qdev_realize_and_unref(radio, bus, &error_fatal);
+    qdev_connect_gpio_out_named(DEVICE(&ss->gpio), "out", nss,
+                                qdev_get_gpio_in_named(radio, SSI_GPIO_CS, 0));
+    qdev_connect_gpio_out_named(DEVICE(&ss->gpio), "out", nreset,
+                                qdev_get_gpio_in_named(radio, "reset", 0));
+    qdev_connect_gpio_out_named(radio, sx1262 ? "dio1" : "dio0", 0,
