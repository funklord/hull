diff --git a/hw/misc/sx126x.c b/hw/misc/sx126x.c
new file mode 100644
index 0000000..d417881
--- /dev/null
+++ b/hw/misc/sx126x.c
@@ -0,0 +1,499 @@
+/*
+ * Semtech SX1261/SX1262 LoRa transceiver, as hull's Heltec WiFi LoRa 32
+ * V3 carries one: its SPI command set in LoRa mode, its data buffer and
+ * registers, transmit and receive, the DIO1 line, and the air.
+ *
+ * Commands are an opcode and its parameters while NSS is low, each byte
+ * answered with the status, or with what a Get or Read command returns;
+ * a command takes effect when NSS rises. BUSY is low throughout: every
+ * command here is done by the time the next can be sent.
+ *
+ * The air is hull's SX1276 model's (sx127x.c): length-prefixed frames,
+ * each LoRa packet an Ethernet frame of type 0x88b5 carrying the sender's
+ * frequency, bandwidth, spreading factor, coding rate, sync word and IQ
+ * polarity in the SX1276's own register encodings, so that the two chips
+ * hear each other as the real ones do. Its time on air is kept as there.
+ *
+ * GFSK is not modelled; its commands are taken and do nothing.
+ */
+
+#include "qemu/osdep.h"
+#include <math.h>
+#include "qemu/log.h"
+#include "qemu/timer.h"
+#include "qemu/module.h"
+#include "qapi/error.h"
+#include "hw/ssi/ssi.h"
+#include "hw/irq.h"
+#include "hw/qdev-properties.h"
+#include "hw/qdev-properties-system.h"
+#include "chardev/char-fe.h"
+
+#define TYPE_SX126X "sx126x"
+OBJECT_DECLARE_SIMPLE_TYPE(Sx126xState, SX126X)
+
+#define AIR_TYPE  0x88b5
+#define AIR_HEAD  (14 + 12)
+#define AIR_MAX   (4 + AIR_HEAD + 256)
+
+/* Chip modes as the status byte gives them, bits 6:4. */
+enum { MODE_STBY_RC = 2, MODE_STBY_XOSC = 3, MODE_FS = 4, MODE_RX = 5, MODE_TX = 6 };
+
+enum {
+    IRQ_TX_DONE = 1 << 0, IRQ_RX_DONE = 1 << 1, IRQ_HEADER_VALID = 1 << 4,
+    IRQ_TIMEOUT = 1 << 9,
+};
+
+struct Sx126xState {
+    SSIPeripheral parent_obj;
+
+    CharBackend air;
+    QEMUTimer *timer;
+    qemu_irq dio1;
+    qemu_irq busy;
+    uint16_t id;
+
+    uint8_t mode;
+    uint8_t sleeping;
+    uint8_t packet_type;          /* 0 GFSK, 1 LoRa */
+    uint32_t rf;                  /* SetRfFrequency's word, Fxtal / 2^25 a step */
+    uint8_t sf, bw, cr, ldro;     /* SetModulationParams' */
+    uint16_t preamble;            /* SetPacketParams' */
+    uint8_t implicit, payload_length, crc, invert_iq;
+    uint8_t tx_base, rx_base;
+    uint16_t irq, irq_mask, dio1_mask;
+    uint8_t rx_length, rx_start;
+    uint8_t buffer[256];
+    uint8_t reg[0x1000];
+    bool single_rx;               /* SetRx with a timeout: one packet, then standby */
+
+    uint8_t cmd[300];
+    unsigned cmd_length;
+    bool selected;
+
+    uint8_t in[2 * AIR_MAX];
+    unsigned in_length;
+    uint8_t out[AIR_MAX];
+    unsigned out_length;
+};
+
+/* SetModulationParams' bandwidth codes, as the SX1276's RegModemConfig1
+ * numbers them, 7.8 kHz to 500 kHz. */
+static unsigned bw_index(uint8_t code)
+{
+    static const uint8_t codes[] = { 0x00, 0x08, 0x01, 0x09, 0x02, 0x0a, 0x03, 0x04, 0x05, 0x06 };
+
+    for (unsigned i = 0; i < sizeof codes; i++) {
+        if (codes[i] == code) {
+            return i;
+        }
+    }
+    return 7;   /* 125 kHz */
+}
+
+static const uint32_t bandwidth_hz[] = {
+    7800, 10400, 15600, 20800, 31250, 41700, 62500, 125000, 250000, 500000,
+};
+
+static uint8_t status_byte(Sx126xState *s)
+{
+    return (uint8_t)(s->mode << 4) | (2u << 1);   /* data available or not: 2, as idle */
+}
+
+static void sx126x_update(Sx126xState *s)
+{
+    qemu_set_irq(s->dio1, (s->irq & s->dio1_mask) != 0);
+}
+
+static void sx126x_raise(Sx126xState *s, uint16_t bits)
+{
+    s->irq |= bits & s->irq_mask;
+    sx126x_update(s);
+}
+
+/* The SX1276's encodings of the settings, which the air carries. */
+static uint32_t frf_1276(Sx126xState *s)
+{
+    return (s->rf + 32) >> 6;
+}
+
+static uint8_t config1(Sx126xState *s)
+{
+    return (uint8_t)(bw_index(s->bw) << 4 | (s->cr & 7) << 1 | (s->implicit & 1));
+}
+
+static uint8_t config2(Sx126xState *s)
+{
+    return (uint8_t)((s->sf & 0xf) << 4 | (s->crc ? 1 << 2 : 0));
+}
+
+static uint8_t sync_1276(Sx126xState *s)
+{
+    return (s->reg[0x740] & 0xf0) | (s->reg[0x741] >> 4);
+}
+
+static int64_t airtime_ns(Sx126xState *s, unsigned length)
+{
+    double hz = bandwidth_hz[bw_index(s->bw)];
+    unsigned sf = s->sf >= 5 && s->sf <= 12 ? s->sf : 7;
+    unsigned cr = s->cr >= 1 && s->cr <= 4 ? s->cr : 1;
+    double symbol = (double)(1u << sf) / hz;
+    double bits = 8.0 * length - 4.0 * sf + 28 + (s->crc ? 16 : 0) - (s->implicit ? 20 : 0);
+    double payload = 8 + MAX(ceil(bits / (4.0 * (sf - (s->ldro ? 2 : 0)))) * (cr + 4), 0);
+
+    return (int64_t)(((s->preamble ? s->preamble : 8) + 4.25 + payload) * symbol * 1e9);
+}
+
+static void sx126x_transmit(Sx126xState *s)
+{
+    unsigned length = s->payload_length;
+    uint8_t *f = s->out + 4;
+    uint32_t frf = frf_1276(s);
+
+    stl_be_p(s->out, AIR_HEAD + length);
+    memset(f, 0xff, 6);
+    f[6] = 0x02;
+    f[7] = 'h';
+    f[8] = 'u';
+    f[9] = 'R';
+    stw_be_p(f + 10, s->id);
+    stw_be_p(f + 12, AIR_TYPE);
+    f[14] = 1;
+    f[15] = frf >> 16;
+    f[16] = frf >> 8;
+    f[17] = frf;
+    f[18] = config1(s);
+    f[19] = config2(s);
+    f[20] = sync_1276(s);
+    f[21] = s->invert_iq & 1;
+    f[22] = f[23] = f[24] = 0;
+    f[25] = length;
+    for (unsigned i = 0; i < length; i++) {
+        f[AIR_HEAD + i] = s->buffer[(uint8_t)(s->tx_base + i)];
+    }
+    s->out_length = 4 + AIR_HEAD + length;
+    s->mode = MODE_TX;
+    timer_mod(s->timer, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) + airtime_ns(s, length));
+}
+
+static void sx126x_timer(void *opaque)
+{
+    Sx126xState *s = opaque;
+
+    if (s->mode == MODE_TX && s->out_length != 0) {
+        if (qemu_chr_fe_backend_connected(&s->air)) {
+            qemu_chr_fe_write_all(&s->air, s->out, s->out_length);
+        }
+        s->out_length = 0;
+        s->mode = MODE_STBY_RC;
+        sx126x_raise(s, IRQ_TX_DONE);
+    }
+}
+
+static void sx126x_hear(Sx126xState *s, const uint8_t *f, unsigned frame)
+{
+    uint32_t frf = frf_1276(s);
+    unsigned length;
+
+    if (frame < AIR_HEAD || lduw_be_p(f + 12) != AIR_TYPE || f[14] != 1 ||
+        lduw_be_p(f + 10) == s->id) {
+        return;
+    }
+    length = f[25];
+    if (frame < AIR_HEAD + length || s->packet_type != 1 || s->mode != MODE_RX ||
+        f[15] != (uint8_t)(frf >> 16) || f[16] != (uint8_t)(frf >> 8) || f[17] != (uint8_t)frf ||
+        (f[18] & 0xf0) != (config1(s) & 0xf0) || (f[19] & 0xf0) != (config2(s) & 0xf0) ||
+        f[20] != sync_1276(s) || (f[21] & 1) != (s->invert_iq & 1)) {
+        return;
+    }
+    for (unsigned i = 0; i < length; i++) {
+        s->buffer[(uint8_t)(s->rx_base + i)] = f[AIR_HEAD + i];
+    }
+    s->rx_start = s->rx_base;
+    s->rx_length = length;
+    if (s->single_rx) {
+        s->mode = MODE_STBY_RC;
+    }
+    sx126x_raise(s, IRQ_HEADER_VALID | IRQ_RX_DONE);
+}
+
+static int sx126x_can_receive(void *opaque)
+{
+    Sx126xState *s = opaque;
+
+    return sizeof(s->in) - s->in_length;
+}
+
+static void sx126x_receive(void *opaque, const uint8_t *buf, int size)
+{
+    Sx126xState *s = opaque;
+
+    memcpy(s->in + s->in_length, buf, size);
+    s->in_length += size;
+    while (s->in_length >= 4) {
+        uint32_t frame = ldl_be_p(s->in);
+
+        if (frame > sizeof(s->in) - 4) {
+            s->in_length = 0;
+            return;
+        }
+        if (s->in_length < 4 + frame) {
+            return;
+        }
+        sx126x_hear(s, s->in + 4, frame);
+        memmove(s->in, s->in + 4 + frame, s->in_length - 4 - frame);
+        s->in_length -= 4 + frame;
+    }
+}
+
+/* A command, its opcode and parameters, done as NSS rises. */
+static void sx126x_execute(Sx126xState *s)
+{
+    const uint8_t *c = s->cmd;
+    unsigned n = s->cmd_length;
+
+    if (n == 0) {
+        return;
+    }
+    switch (c[0]) {
+    case 0x80:   /* SetStandby */
+        s->mode = (n > 1 && c[1]) ? MODE_STBY_XOSC : MODE_STBY_RC;
+        s->sleeping = 0;
+        timer_del(s->timer);
+        s->out_length = 0;
+        break;
+    case 0x84:   /* SetSleep */
+        s->sleeping = 1;
+        s->mode = MODE_STBY_RC;
+        break;
+    case 0xc1:   /* SetFs */
+        s->mode = MODE_FS;
+        break;
+    case 0x8a:   /* SetPacketType */
+        if (n > 1) {
+            s->packet_type = c[1];
+        }
+        break;
+    case 0x86:   /* SetRfFrequency */
+        if (n > 4) {
+            s->rf = ldl_be_p(c + 1);
+        }
+        break;
+    case 0x8b:   /* SetModulationParams, LoRa's */
+        if (n > 4) {
+            s->sf = c[1];
+            s->bw = c[2];
+            s->cr = c[3];
+            s->ldro = c[4];
+        }
+        break;
+    case 0x8c:   /* SetPacketParams, LoRa's */
+        if (n > 6) {
+            s->preamble = lduw_be_p(c + 1);
+            s->implicit = c[3];
+            s->payload_length = c[4];
+            s->crc = c[5];
+            s->invert_iq = c[6];
+        }
+        break;
+    case 0x8f:   /* SetBufferBaseAddress */
+        if (n > 2) {
+            s->tx_base = c[1];
+            s->rx_base = c[2];
+        }
+        break;
+    case 0x0e:   /* WriteBuffer */
+        for (unsigned i = 2; i < n; i++) {
+            s->buffer[(uint8_t)(c[1] + i - 2)] = c[i];
+        }
+        break;
+    case 0x0d:   /* WriteRegister */
+        for (unsigned i = 3; i < n; i++) {
+            s->reg[(lduw_be_p(c + 1) + i - 3) & 0xfff] = c[i];
+        }
+        break;
+    case 0x08:   /* SetDioIrqParams */
+        if (n > 4) {
+            s->irq_mask = lduw_be_p(c + 1);
+            s->dio1_mask = lduw_be_p(c + 3);
+            sx126x_update(s);
+        }
+        break;
+    case 0x02:   /* ClearIrqStatus */
+        if (n > 2) {
+            s->irq &= ~lduw_be_p(c + 1);
+            sx126x_update(s);
+        }
+        break;
+    case 0x83:   /* SetTx */
+        if (s->packet_type == 1) {
+            sx126x_transmit(s);
+        }
+        break;
+    case 0x82:   /* SetRx: 0 or 0xffffff continuous, else one packet */
+        if (n > 3) {
+            uint32_t timeout = (uint32_t)c[1] << 16 | c[2] << 8 | c[3];
+
+            s->single_rx = timeout != 0 && timeout != 0xffffff;
+        }
+        s->mode = MODE_RX;
+        break;
+    default:     /* calibration, regulator, TCXO, RF switch, PA: nothing to do */
+        break;
+    }
+}
+
+/* What the chip answers to byte `n` of the command in progress. */
+static uint8_t sx126x_answer(Sx126xState *s, unsigned n)
+{
+    const uint8_t *c = s->cmd;
+
+    if (n == 0) {
+        return status_byte(s);
+    }
+    switch (c[0]) {
+    case 0x1d:   /* ReadRegister: address, NOP, then data */
+        return n >= 4 ? s->reg[(lduw_be_p(c + 1) + n - 4) & 0xfff] : status_byte(s);
+    case 0x1e:   /* ReadBuffer: offset, NOP, then data */
+        return n >= 3 ? s->buffer[(uint8_t)(c[1] + n - 3)] : status_byte(s);
+    case 0x12:   /* GetIrqStatus */
+        return n == 1 ? status_byte(s) : n == 2 ? s->irq >> 8 : s->irq & 0xff;
+    case 0x13:   /* GetRxBufferStatus */
+        return n == 1 ? status_byte(s) : n == 2 ? s->rx_length : s->rx_start;
+    case 0x14:   /* GetPacketStatus: RSSI -60 dBm, SNR 10 dB */
+        return n == 1 ? status_byte(s) : n == 3 ? 40 : 120;
+    case 0x15:   /* GetRssiInst */
+        return n == 1 ? status_byte(s) : 200;
+    case 0x11:   /* GetPacketType */
+        return n == 1 ? status_byte(s) : s->packet_type;
+    case 0x17:   /* GetDeviceErrors */
+        return n == 1 ? status_byte(s) : 0;
+    default:
+        return status_byte(s);
+    }
+}
+
+static uint32_t sx126x_transfer(SSIPeripheral *dev, uint32_t value)
+{
+    Sx126xState *s = SX126X(dev);
+    unsigned n = s->cmd_length;
+    uint8_t answer;
+
+    if (!s->selected) {
+        return 0xff;
+    }
+    if (n < sizeof(s->cmd)) {
+        s->cmd[n] = (uint8_t)value;
+        s->cmd_length = n + 1;
+    }
+    answer = sx126x_answer(s, n);
+    return answer;
+}
+
+/* qemu's SSI core gives the line's level, low for selected, NSS being
+ * active low. */
+static int sx126x_set_cs(SSIPeripheral *dev, bool level)
+{
+    Sx126xState *s = SX126X(dev);
+    bool select = !level;
+
+    if (select) {
+        s->selected = true;
+        s->cmd_length = 0;
+    } else if (s->selected) {
+        s->selected = false;
+        sx126x_execute(s);
+        s->cmd_length = 0;
+    }
+    return 0;
+}
+
+static void sx126x_reset_state(Sx126xState *s)
+{
+    timer_del(s->timer);
+    s->mode = MODE_STBY_RC;
+    s->sleeping = 0;
+    s->packet_type = 0;
+    s->rf = 0;
+    s->sf = 7;
+    s->bw = 0x04;
+    s->cr = 1;
+    s->ldro = 0;
+    s->preamble = 8;
+    s->implicit = s->crc = s->invert_iq = 0;
+    s->payload_length = 0;
+    s->tx_base = s->rx_base = 0;
+    s->irq = s->irq_mask = s->dio1_mask = 0;
+    s->rx_length = s->rx_start = 0;
+    s->out_length = 0;
+    s->single_rx = false;
+    memset(s->reg, 0, sizeof(s->reg));
+    /* The version string LoRa libraries look for, and the private sync
+     * word, 0x1424, as at reset. */
+    memcpy(s->reg + 0x320, "SX1261 V2D 2D02", 16);
+    s->reg[0x740] = 0x14;
+    s->reg[0x741] = 0x24;
+    sx126x_update(s);
+    qemu_set_irq(s->busy, 0);
+}
+
+static void sx126x_reset_line(void *opaque, int line, int level)
+{
+    Sx126xState *s = opaque;
+
+    if (!level) {   /* NRESET low: held in reset */
+        sx126x_reset_state(s);
+    }
+}
+
+static void sx126x_realize(SSIPeripheral *dev, Error **errp)
+{
+    Sx126xState *s = SX126X(dev);
+
+    s->timer = timer_new_ns(QEMU_CLOCK_VIRTUAL, sx126x_timer, s);
+    s->id = (uint16_t)g_random_int();
+    qdev_init_gpio_out_named(DEVICE(dev), &s->dio1, "dio1", 1);
+    qdev_init_gpio_out_named(DEVICE(dev), &s->busy, "busy", 1);
+    qdev_init_gpio_in_named(DEVICE(dev), sx126x_reset_line, "reset", 1);
+    qemu_chr_fe_set_handlers(&s->air, sx126x_can_receive, sx126x_receive, NULL, NULL, s,
+                             NULL, true);
+    sx126x_reset_state(s);
+}
+
+static void sx126x_reset(DeviceState *dev)
+{
+    sx126x_reset_state(SX126X(dev));
+}
+
+static Property sx126x_properties[] = {
+    DEFINE_PROP_CHR("chardev", Sx126xState, air),
+    DEFINE_PROP_END_OF_LIST(),
+};
+
+static void sx126x_class_init(ObjectClass *klass, void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    SSIPeripheralClass *k = SSI_PERIPHERAL_CLASS(klass);
+
+    k->realize = sx126x_realize;
+    k->transfer = sx126x_transfer;
+    k->set_cs = sx126x_set_cs;
+    k->cs_polarity = SSI_CS_LOW;
+    device_class_set_legacy_reset(dc, sx126x_reset);
+    device_class_set_props(dc, sx126x_properties);
+    dc->desc = "Semtech SX1262 LoRa transceiver";
+}
+
+static const TypeInfo sx126x_info = {
+    .name = TYPE_SX126X,
+    .parent = TYPE_SSI_PERIPHERAL,
+    .instance_size = sizeof(Sx126xState),
+    .class_init = sx126x_class_init,
+};
+
+static void sx126x_register_types(void)
+{
+    type_register_static(&sx126x_info);
+}
+
+type_init(sx126x_register_types)
diff --git a/hw/misc/sx127x.c b/hw/misc/sx127x.c
new file mode 100644
index 0000000..6c31fb6
--- /dev/null
+++ b/hw/misc/sx127x.c
@@ -0,0 +1,473 @@
+/*
+ * Semtech SX1276/77/78/79 LoRa transceiver, as hull's ESP32 boards carry
+ * it (a Heltec WiFi LoRa 32, a TTGO LoRa32): its SPI register file and
+ * FIFO in LoRa mode, transmit and receive, the DIO0 line, and the air.
+ *
+ * The air is a character device speaking the length-prefixed frames of
+ * qemu's stream netdev, each LoRa packet an Ethernet frame to the
+ * broadcast address of type 0x88b5, so that a switch that carries a
+ * stream netdev's frames carries radios too. A packet is heard by every
+ * other radio on that air in a receive mode on the same frequency,
+ * spreading factor, bandwidth, sync word and IQ polarity -- no range, no
+ * collisions, no loss, a fixed RSSI and SNR. Its time on air is kept: the
+ * sender's TxDone comes when the packet would have ended, and the packet
+ * is sent then.
+ *
+ * FSK/OOK mode is not modelled; its registers read back what was written.
+ */
+
+#include "qemu/osdep.h"
+#include <math.h>
+#include "qemu/log.h"
+#include "qemu/timer.h"
+#include "qemu/module.h"
+#include "qapi/error.h"
+#include "hw/ssi/ssi.h"
+#include "hw/irq.h"
+#include "hw/qdev-properties.h"
+#include "hw/qdev-properties-system.h"
+#include "chardev/char-fe.h"
+#include "qom/object.h"
+
+#define TYPE_SX127X "sx127x"
+OBJECT_DECLARE_SIMPLE_TYPE(Sx127xState, SX127X)
+
+enum {
+    REG_FIFO = 0x00,
+    REG_OP_MODE = 0x01,
+    REG_FRF_MSB = 0x06,
+    REG_FRF_MID = 0x07,
+    REG_FRF_LSB = 0x08,
+    REG_FIFO_ADDR_PTR = 0x0d,
+    REG_FIFO_TX_BASE = 0x0e,
+    REG_FIFO_RX_BASE = 0x0f,
+    REG_FIFO_RX_CURRENT = 0x10,
+    REG_IRQ_FLAGS_MASK = 0x11,
+    REG_IRQ_FLAGS = 0x12,
+    REG_RX_NB_BYTES = 0x13,
+    REG_MODEM_STAT = 0x18,
+    REG_PKT_SNR = 0x19,
+    REG_PKT_RSSI = 0x1a,
+    REG_RSSI = 0x1b,
+    REG_MODEM_CONFIG1 = 0x1d,
+    REG_MODEM_CONFIG2 = 0x1e,
+    REG_PREAMBLE_MSB = 0x20,
+    REG_PREAMBLE_LSB = 0x21,
+    REG_PAYLOAD_LENGTH = 0x22,
+    REG_MODEM_CONFIG3 = 0x26,
+    REG_RSSI_WIDEBAND = 0x2c,
+    REG_INVERT_IQ = 0x33,
+    REG_SYNC_WORD = 0x39,
+    REG_DIO_MAPPING1 = 0x40,
+    REG_VERSION = 0x42,
+};
+
+#define MODE_LORA       0x80
+#define MODE_MASK       0x07
+#define MODE_SLEEP      0
+#define MODE_STDBY      1
+#define MODE_TX         3
+#define MODE_RX_CONT    5
+#define MODE_RX_SINGLE  6
+#define MODE_CAD        7
+
+#define IRQ_CAD_DETECTED 0x01
+#define IRQ_CAD_DONE     0x04
+#define IRQ_TX_DONE      0x08
+#define IRQ_VALID_HEADER 0x10
+#define IRQ_RX_DONE      0x40
+
+#define AIR_TYPE    0x88b5
+#define AIR_HEAD    (14 + 12)
+#define AIR_MAX     (4 + AIR_HEAD + 256)
+
+struct Sx127xState {
+    SSIPeripheral parent_obj;
+
+    CharBackend air;
+    qemu_irq dio0;
+    QEMUTimer *timer;
+    uint8_t reg[128];
+    uint8_t fifo[256];
+    uint8_t address;      /* the access under way, 0xff before its address */
+    bool writing;
+    bool in_reset;
+    uint16_t id;          /* this radio's, in its frames' source */
+    uint8_t in[AIR_MAX];  /* a frame from the air, being gathered */
+    uint32_t in_length;
+    uint8_t out[AIR_MAX]; /* the packet being sent, until its airtime ends */
+    uint32_t out_length;
+};
+
+static const uint32_t bandwidth_hz[] = {
+    7800, 10400, 15600, 20800, 31250, 41700, 62500, 125000, 250000, 500000,
+};
+
+static void sx127x_reset_registers(Sx127xState *s)
+{
+    memset(s->reg, 0, sizeof(s->reg));
+    memset(s->fifo, 0, sizeof(s->fifo));
+    s->reg[REG_OP_MODE] = 0x09;
+    s->reg[REG_FRF_MSB] = 0x6c;
+    s->reg[REG_FRF_MID] = 0x80;
+    s->reg[0x09] = 0x4f;
+    s->reg[0x0a] = 0x09;
+    s->reg[0x0b] = 0x2b;
+    s->reg[0x0c] = 0x20;
+    s->reg[REG_FIFO_TX_BASE] = 0x80;
+    s->reg[REG_MODEM_CONFIG1] = 0x72;
+    s->reg[REG_MODEM_CONFIG2] = 0x70;
+    s->reg[0x1f] = 0x64;
+    s->reg[REG_PREAMBLE_LSB] = 0x08;
+    s->reg[REG_PAYLOAD_LENGTH] = 0x01;
+    s->reg[0x23] = 0xff;
+    s->reg[0x31] = 0xc3;
+    s->reg[REG_INVERT_IQ] = 0x27;
+    s->reg[0x37] = 0x0a;
+    s->reg[REG_SYNC_WORD] = 0x12;
+    s->reg[REG_VERSION] = 0x12;
+    s->reg[0x4d] = 0x84;
+    s->address = 0xff;
+    s->out_length = 0;
+    timer_del(s->timer);
+}
+
+static unsigned sx127x_mode(Sx127xState *s)
+{
+    return s->reg[REG_OP_MODE] & MODE_MASK;
+}
+
+/* DIO0 by RegDioMapping1's top two bits: RxDone, TxDone or CadDone. */
+static void sx127x_update_dio0(Sx127xState *s)
+{
+    static const uint8_t by_mapping[4] = { IRQ_RX_DONE, IRQ_TX_DONE, IRQ_CAD_DONE, 0 };
+    uint8_t flag = by_mapping[s->reg[REG_DIO_MAPPING1] >> 6];
+
+    qemu_set_irq(s->dio0, (s->reg[REG_IRQ_FLAGS] & flag & ~s->reg[REG_IRQ_FLAGS_MASK]) != 0);
+}
+
+static void sx127x_raise(Sx127xState *s, uint8_t flags)
+{
+    s->reg[REG_IRQ_FLAGS] |= flags;
+    sx127x_update_dio0(s);
+}
+
+/* The packet's time on air in ns, by Semtech's formula (AN1200.13). */
+static int64_t sx127x_airtime(Sx127xState *s, unsigned length)
+{
+    unsigned bw = s->reg[REG_MODEM_CONFIG1] >> 4;
+    unsigned cr = (s->reg[REG_MODEM_CONFIG1] >> 1) & 7;
+    bool implicit = s->reg[REG_MODEM_CONFIG1] & 1;
+    unsigned sf = s->reg[REG_MODEM_CONFIG2] >> 4;
+    bool crc = s->reg[REG_MODEM_CONFIG2] & 4;
+    unsigned preamble = (s->reg[REG_PREAMBLE_MSB] << 8) | s->reg[REG_PREAMBLE_LSB];
+    double hz = bandwidth_hz[bw < 10 ? bw : 7];
+    double symbol, bits, payload;
+    bool low_rate;
+
+    if (sf < 6 || sf > 12) {
+        sf = 7;
+    }
+    if (cr < 1 || cr > 4) {
+        cr = 1;
+    }
+    symbol = (double)(1u << sf) / hz;
+    low_rate = symbol > 0.016;
+    bits = 8.0 * length - 4.0 * sf + 28 + (crc ? 16 : 0) - (implicit ? 20 : 0);
+    payload = 8 + MAX(ceil(bits / (4.0 * (sf - (low_rate ? 2 : 0)))) * (cr + 4), 0);
+    return (int64_t)(((preamble + 4.25) + payload) * symbol * 1e9);
+}
+
+/* The FIFO's payload as a frame on the air, into s->out. */
+static void sx127x_frame(Sx127xState *s)
+{
+    unsigned length = s->reg[REG_PAYLOAD_LENGTH];
+    uint8_t *f = s->out + 4;
+    unsigned frame = AIR_HEAD + length;
+
+    stl_be_p(s->out, frame);
+    memset(f, 0xff, 6);
+    f[6] = 0x02;
+    f[7] = 0x00;
+    f[8] = 'L';
+    f[9] = 'R';
+    stw_be_p(f + 10, s->id);
+    stw_be_p(f + 12, AIR_TYPE);
+    f[14] = 1;                                  /* version */
+    f[15] = s->reg[REG_FRF_MSB];
+    f[16] = s->reg[REG_FRF_MID];
+    f[17] = s->reg[REG_FRF_LSB];
+    f[18] = s->reg[REG_MODEM_CONFIG1];
+    f[19] = s->reg[REG_MODEM_CONFIG2];
+    f[20] = s->reg[REG_SYNC_WORD];
+    /* RegInvertIQ's bit 0 is set for a normal transmission, clear for an
+     * inverted one -- its reset value 0x27 is normal both ways, and
+     * arduino-LoRa's enableInvertIQ() writes 0x66 -- where bit 6 is set
+     * for an inverted reception. */
+    f[21] = !(s->reg[REG_INVERT_IQ] & 1);       /* transmitted inverted */
+    f[22] = 0;
+    f[23] = 0;
+    f[24] = 0;
+    f[25] = length;
+    for (unsigned i = 0; i < length; i++) {
+        f[AIR_HEAD + i] = s->fifo[(uint8_t)(s->reg[REG_FIFO_TX_BASE] + i)];
+    }
+    s->out_length = 4 + frame;
+}
+
+/* The airtime over: the packet on the air, TxDone, and standby. */
+static void sx127x_timer(void *opaque)
+{
+    Sx127xState *s = opaque;
+    unsigned mode = sx127x_mode(s);
+
+    if (mode == MODE_TX && s->out_length != 0) {
+        if (qemu_chr_fe_backend_connected(&s->air)) {
+            qemu_chr_fe_write_all(&s->air, s->out, s->out_length);
+        }
+        s->out_length = 0;
+        s->reg[REG_OP_MODE] = (s->reg[REG_OP_MODE] & ~MODE_MASK) | MODE_STDBY;
+        sx127x_raise(s, IRQ_TX_DONE);
+    } else if (mode == MODE_CAD) {
+        s->reg[REG_OP_MODE] = (s->reg[REG_OP_MODE] & ~MODE_MASK) | MODE_STDBY;
+        sx127x_raise(s, IRQ_CAD_DONE);
+    }
+}
+
+static void sx127x_set_mode(Sx127xState *s, uint8_t value)
+{
+    unsigned before = sx127x_mode(s);
+
+    s->reg[REG_OP_MODE] = value;
+    if (!(value & MODE_LORA) || (value & MODE_MASK) == before) {
+        return;
+    }
+    switch (value & MODE_MASK) {
+    case MODE_TX:
+        sx127x_frame(s);
+        timer_mod(s->timer, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) +
+                  sx127x_airtime(s, s->reg[REG_PAYLOAD_LENGTH]));
+        break;
+    case MODE_CAD:
+        timer_mod(s->timer, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) + 1000000);
+        break;
+    default:
+        timer_del(s->timer);
+        s->out_length = 0;
+        break;
+    }
+}
+
+static uint8_t sx127x_read(Sx127xState *s, uint8_t address)
+{
+    switch (address) {
+    case REG_FIFO:
+        return s->fifo[s->reg[REG_FIFO_ADDR_PTR]++];
+    case REG_RSSI_WIDEBAND:
+        return (uint8_t)g_random_int();
+    case REG_RSSI:
+        return sx127x_mode(s) == MODE_RX_CONT || sx127x_mode(s) == MODE_RX_SINGLE ? 40 : 0;
+    default:
+        return s->reg[address];
+    }
+}
+
+static void sx127x_write(Sx127xState *s, uint8_t address, uint8_t value)
+{
+    switch (address) {
+    case REG_FIFO:
+        s->fifo[s->reg[REG_FIFO_ADDR_PTR]++] = value;
+        break;
+    case REG_OP_MODE:
+        sx127x_set_mode(s, value);
+        break;
+    case REG_IRQ_FLAGS:
+        s->reg[REG_IRQ_FLAGS] &= ~value;
+        sx127x_update_dio0(s);
+        break;
+    case REG_IRQ_FLAGS_MASK:
+    case REG_DIO_MAPPING1:
+        s->reg[address] = value;
+        sx127x_update_dio0(s);
+        break;
+    case REG_VERSION:
+    case REG_RX_NB_BYTES:
+    case REG_FIFO_RX_CURRENT:
+    case REG_MODEM_STAT:
+    case REG_PKT_SNR:
+    case REG_PKT_RSSI:
+        break;
+    default:
+        s->reg[address] = value;
+        break;
+    }
+}
+
+/* A byte on SPI: the first of an access is its address, bit 7 set for a
+ * write; the rest its data, the address moving on but at the FIFO. */
+static uint32_t sx127x_transfer(SSIPeripheral *dev, uint32_t value)
+{
+    Sx127xState *s = SX127X(dev);
+    uint8_t byte = value;
+    uint8_t answer = 0;
+
+    if (s->in_reset) {
+        return 0;
+    }
+    if (s->address == 0xff) {
+        s->address = byte & 0x7f;
+        s->writing = byte & 0x80;
+        return 0;
+    }
+    if (s->writing) {
+        sx127x_write(s, s->address, byte);
+    } else {
+        answer = sx127x_read(s, s->address);
+    }
+    if (s->address != REG_FIFO) {
+        s->address = (s->address + 1) & 0x7f;
+    }
+    return answer;
+}
+
+static int sx127x_set_cs(SSIPeripheral *dev, bool select)
+{
+    Sx127xState *s = SX127X(dev);
+
+    s->address = 0xff;
+    return 0;
+}
+
+/* NRESET, low holding the chip in reset. */
+static void sx127x_reset_line(void *opaque, int line, int level)
+{
+    Sx127xState *s = opaque;
+
+    if (!level) {
+        s->in_reset = true;
+    } else if (s->in_reset) {
+        s->in_reset = false;
+        sx127x_reset_registers(s);
+        sx127x_update_dio0(s);
+    }
+}
+
+/* A packet heard: kept where this radio listens for it alike. */
+static void sx127x_hear(Sx127xState *s, const uint8_t *f, unsigned frame)
+{
+    unsigned mode = sx127x_mode(s);
+    unsigned length;
+    uint8_t base;
+
+    if (frame < AIR_HEAD || lduw_be_p(f + 12) != AIR_TYPE || f[14] != 1 ||
+        lduw_be_p(f + 10) == s->id) {
+        return;
+    }
+    length = f[25];
+    if (frame < AIR_HEAD + length || !(s->reg[REG_OP_MODE] & MODE_LORA) ||
+        (mode != MODE_RX_CONT && mode != MODE_RX_SINGLE) ||
+        f[15] != s->reg[REG_FRF_MSB] || f[16] != s->reg[REG_FRF_MID] ||
+        f[17] != s->reg[REG_FRF_LSB] ||
+        (f[18] & 0xf0) != (s->reg[REG_MODEM_CONFIG1] & 0xf0) ||
+        (f[19] & 0xf0) != (s->reg[REG_MODEM_CONFIG2] & 0xf0) ||
+        f[20] != s->reg[REG_SYNC_WORD] ||
+        (f[21] & 1) != ((s->reg[REG_INVERT_IQ] >> 6) & 1)) {
+        return;
+    }
+    base = s->reg[REG_FIFO_RX_BASE];
+    for (unsigned i = 0; i < length; i++) {
+        s->fifo[(uint8_t)(base + i)] = f[AIR_HEAD + i];
+    }
+    s->reg[REG_FIFO_RX_CURRENT] = base;
+    s->reg[REG_RX_NB_BYTES] = length;
+    s->reg[REG_PKT_SNR] = 40;                   /* 10 dB, in quarters */
+    s->reg[REG_PKT_RSSI] = 97;                  /* -60 dBm on the HF port */
+    if (mode == MODE_RX_SINGLE) {
+        s->reg[REG_OP_MODE] = (s->reg[REG_OP_MODE] & ~MODE_MASK) | MODE_STDBY;
+    }
+    sx127x_raise(s, IRQ_VALID_HEADER | IRQ_RX_DONE);
+}
+
+static int sx127x_can_receive(void *opaque)
+{
+    Sx127xState *s = opaque;
+
+    return sizeof(s->in) - s->in_length;
+}
+
+static void sx127x_receive(void *opaque, const uint8_t *buf, int size)
+{
+    Sx127xState *s = opaque;
+
+    memcpy(s->in + s->in_length, buf, size);
+    s->in_length += size;
+    while (s->in_length >= 4) {
+        uint32_t frame = ldl_be_p(s->in);
+
+        if (frame > sizeof(s->in) - 4) {
+            /* No frame of a radio's: the air's framing is lost, start over. */
+            s->in_length = 0;
+            return;
+        }
+        if (s->in_length < 4 + frame) {
+            return;
+        }
+        sx127x_hear(s, s->in + 4, frame);
+        memmove(s->in, s->in + 4 + frame, s->in_length - 4 - frame);
+        s->in_length -= 4 + frame;
+    }
+}
+
+static void sx127x_realize(SSIPeripheral *dev, Error **errp)
+{
+    Sx127xState *s = SX127X(dev);
+
+    s->timer = timer_new_ns(QEMU_CLOCK_VIRTUAL, sx127x_timer, s);
+    s->id = (uint16_t)g_random_int();
+    qdev_init_gpio_out_named(DEVICE(dev), &s->dio0, "dio0", 1);
+    qdev_init_gpio_in_named(DEVICE(dev), sx127x_reset_line, "reset", 1);
+    qemu_chr_fe_set_handlers(&s->air, sx127x_can_receive, sx127x_receive, NULL, NULL, s,
+                             NULL, true);
+    sx127x_reset_registers(s);
+}
+
+static void sx127x_reset(DeviceState *dev)
+{
+    Sx127xState *s = SX127X(dev);
+
+    sx127x_reset_registers(s);
+    s->in_reset = false;
+}
+
+static Property sx127x_properties[] = {
+    DEFINE_PROP_CHR("chardev", Sx127xState, air),
+    DEFINE_PROP_END_OF_LIST(),
+};
+
+static void sx127x_class_init(ObjectClass *klass, void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    SSIPeripheralClass *k = SSI_PERIPHERAL_CLASS(klass);
+
+    k->realize = sx127x_realize;
+    k->transfer = sx127x_transfer;
+    k->set_cs = sx127x_set_cs;
+    k->cs_polarity = SSI_CS_LOW;
+    device_class_set_legacy_reset(dc, sx127x_reset);
+    device_class_set_props(dc, sx127x_properties);
+    dc->desc = "Semtech SX1276 LoRa transceiver";
+}
+
+static const TypeInfo sx127x_info = {
+    .name = TYPE_SX127X,
+    .parent = TYPE_SSI_PERIPHERAL,
+    .instance_size = sizeof(Sx127xState),
+    .class_init = sx127x_class_init,
+};
+
+static void sx127x_register_types(void)
+{
+    type_register_static(&sx127x_info);
+}
+
+type_init(sx127x_register_types)
