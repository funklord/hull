diff --git a/hw/gpio/esp32_gpio.c b/hw/gpio/esp32_gpio.c
index 5e25782..5c2f15a 100644
--- a/hw/gpio/esp32_gpio.c
+++ b/hw/gpio/esp32_gpio.c
@@ -21,6 +21,20 @@
 
 
 
+/* The pins enabled for a CPU, bit 13 of a pin's register the APP CPU's,
+ * bit 15 the PRO CPU's. */
+static uint32_t esp32_gpio_enabled(Esp32GpioState *s, uint32_t bit)
+{
+    uint32_t mask = 0;
+
+    for (int pin = 0; pin < 32; pin++) {
+        if (s->pin_regs[pin] & bit) {
+            mask |= 1u << pin;
+        }
+    }
+    return mask;
+}
+
 static uint64_t esp32_gpio_read(void *opaque, hwaddr addr, unsigned int size)
 {
     Esp32GpioState *s = ESP32_GPIO(opaque);
@@ -32,15 +46,76 @@ static uint64_t esp32_gpio_read(void *opaque, hwaddr addr, unsigned int size)
         r = s->gpio_out;
     } else if (s->enable_off && addr == s->enable_off) {
         r = s->gpio_enable;
+    } else if (s->status_off && addr == s->status_off) {
+        r = s->status;
+    } else if (s->acpu_int_off && addr == s->acpu_int_off) {
+        r = s->status & esp32_gpio_enabled(s, 1u << 13);
+    } else if (s->pcpu_int_off && addr == s->pcpu_int_off) {
+        r = s->status & esp32_gpio_enabled(s, 1u << 15);
+    } else if (s->pin_off && addr >= s->pin_off && addr < s->pin_off + 4 * ESP_GPIO_MAX_PINS) {
+        r = s->pin_regs[(addr - s->pin_off) / 4];
     } else if (s->in_off && addr == s->in_off) {
         /* Output-enabled pins loop back; undriven pins reflect pull-up state */
         r = (s->gpio_out & s->gpio_enable) |
-            (s->gpio_pullup & ~s->gpio_enable);
+            (s->in_level & s->in_driven & ~s->gpio_enable) |
+            (s->gpio_pullup & ~s->gpio_enable & ~s->in_driven);
     }
 
     return r;
 }
 
+/* A pin's output level, where it is an output, to its "out" line; a pin
+ * that is no output is left high, as its pull-up would leave it. */
+static void esp32_gpio_update_out(Esp32GpioState *s)
+{
+    uint32_t level = (s->gpio_out & s->gpio_enable) | ~s->gpio_enable;
+    uint32_t changed = level ^ s->out_seen;
+
+    s->out_seen = level;
+    for (int pin = 0; pin < 32; pin++) {
+        if (changed & (1u << pin)) {
+            qemu_set_irq(s->out[pin], (level >> pin) & 1);
+        }
+    }
+}
+
+/* A level interrupt's status held while its level is; the line to the
+ * interrupt matrix up while either CPU has a pin of its own set. */
+static void esp32_gpio_update_irq(Esp32GpioState *s)
+{
+    if (!s->pin_off) {
+        return;
+    }
+    for (int pin = 0; pin < 32; pin++) {
+        unsigned type = (s->pin_regs[pin] >> 7) & 7;
+        int level = (s->in_level >> pin) & 1;
+
+        if ((s->in_driven & (1u << pin)) && ((type == 4 && !level) || (type == 5 && level))) {
+            s->status |= 1u << pin;
+        }
+    }
+    qemu_set_irq(s->irq, (s->status & (esp32_gpio_enabled(s, 1u << 13) |
+                                       esp32_gpio_enabled(s, 1u << 15))) != 0);
+}
+
+static void esp32_gpio_in(void *opaque, int pin, int level)
+{
+    Esp32GpioState *s = ESP32_GPIO(opaque);
+    int before = (s->in_level >> pin) & 1;
+    unsigned type = (s->pin_regs[pin] >> 7) & 7;
+
+    s->in_driven |= 1u << pin;
+    if (level) {
+        s->in_level |= 1u << pin;
+    } else {
+        s->in_level &= ~(1u << pin);
+    }
+    if (level != before && ((type == 1 && level) || (type == 2 && !level) || type == 3)) {
+        s->status |= 1u << pin;
+    }
+    esp32_gpio_update_irq(s);
+}
+
 static void esp32_gpio_write(void *opaque, hwaddr addr,
                        uint64_t value, unsigned int size)
 {
@@ -58,7 +133,17 @@ static void esp32_gpio_write(void *opaque, hwaddr addr,
         s->gpio_enable |= (uint32_t)value;
     } else if (s->enable_w1tc_off && addr == s->enable_w1tc_off) {
         s->gpio_enable &= ~(uint32_t)value;
+    } else if (s->status_off && addr == s->status_off) {
+        s->status = (uint32_t)value;
+    } else if (s->status_w1ts_off && addr == s->status_w1ts_off) {
+        s->status |= (uint32_t)value;
+    } else if (s->status_w1tc_off && addr == s->status_w1tc_off) {
+        s->status &= ~(uint32_t)value;
+    } else if (s->pin_off && addr >= s->pin_off && addr < s->pin_off + 4 * ESP_GPIO_MAX_PINS) {
+        s->pin_regs[(addr - s->pin_off) / 4] = (uint32_t)value;
     }
+    esp32_gpio_update_out(s);
+    esp32_gpio_update_irq(s);
 }
 
 static const MemoryRegionOps gpio_ops = {
@@ -124,6 +209,9 @@ static void esp32_gpio_init(Object *obj)
     sysbus_init_mmio(sbd, &s->iomux);
 
     sysbus_init_irq(sbd, &s->irq);
+    s->out_seen = 0xffffffffu;
+    qdev_init_gpio_out_named(DEVICE(obj), s->out, "out", 32);
+    qdev_init_gpio_in_named(DEVICE(obj), esp32_gpio_in, "in", 32);
 }
 
 static Property esp32_gpio_properties[] = {
diff --git a/hw/misc/esp32_ana.c b/hw/misc/esp32_ana.c
new file mode 100644
index 0000000..37124ac
--- /dev/null
+++ b/hw/misc/esp32_ana.c
@@ -0,0 +1,81 @@
+#include "qemu/osdep.h"
+#include "qemu/log.h"
+#include "qemu/error-report.h"
+#include "qemu/guest-random.h"
+#include "qapi/error.h"
+#include "hw/hw.h"
+#include "hw/sysbus.h"
+#include "hw/misc/esp32_ana.h"
+
+#define DEBUG 0
+
+int esp32_wifi_channel=0;
+
+static uint64_t esp32_ana_read(void *opaque, hwaddr addr, unsigned int size)
+{
+    Esp32AnaState *s = ESP32_ANA(opaque);
+    uint32_t r = s->mem[addr/4];
+    switch(addr) {    
+        case 0x04: 
+          r= 0xFDFFFFFF;
+          break;
+        case 0x44:
+        case 0x4C:
+        case 0xC4: 
+          r=0xFFFFFFFF;
+          break;
+    }
+    if(DEBUG) printf("esp32_ana_read  0x%04lx= 0x%08x\n",(unsigned long) addr,r);
+
+    return r;
+}
+
+static void esp32_ana_write(void *opaque, hwaddr addr, uint64_t value,
+                                 unsigned int size) {
+    Esp32AnaState *s = ESP32_ANA(opaque);
+
+    if(DEBUG) printf("esp32_ana_write 0x%04lx= 0x%08lx\n",(unsigned long) addr, (unsigned long) value);
+
+    if(addr == 0xC4) {
+        //printf("wifi channel:%x %x\n",(int)value, (int)~value);
+        int v=value & 0xFF;
+        if((v % 10) ==4 ){ 
+            esp32_wifi_channel=(v/10)-1;
+            //printf("===========> esp32_wifi_channel %i \n", esp32_wifi_channel);
+        }
+    }
+    s->mem[addr/4]=value;
+
+}
+
+static const MemoryRegionOps esp32_ana_ops = {
+    .read =  esp32_ana_read,
+    .write = esp32_ana_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+};
+
+static void esp32_ana_init(Object *obj)
+{
+    Esp32AnaState *s = ESP32_ANA(obj);
+    SysBusDevice *sbd = SYS_BUS_DEVICE(obj);
+
+    memory_region_init_io(&s->iomem, obj, &esp32_ana_ops, s,
+                          TYPE_ESP32_ANA, 0x1000);
+    sysbus_init_mmio(sbd, &s->iomem);
+    memset(s->mem,0,sizeof(s->mem));
+}
+
+
+static const TypeInfo esp32_ana_info = {
+    .name = TYPE_ESP32_ANA,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(Esp32AnaState),
+    .instance_init = esp32_ana_init,
+};
+
+static void esp32_ana_register_types(void)
+{
+    type_register_static(&esp32_ana_info);
+}
+
+type_init(esp32_ana_register_types)
diff --git a/hw/misc/esp32_fe.c b/hw/misc/esp32_fe.c
new file mode 100644
index 0000000..181e460
--- /dev/null
+++ b/hw/misc/esp32_fe.c
@@ -0,0 +1,67 @@
+
+#include "qemu/osdep.h"
+#include "qemu/log.h"
+#include "qemu/error-report.h"
+#include "qemu/guest-random.h"
+#include "qapi/error.h"
+#include "hw/hw.h"
+#include "hw/sysbus.h"
+#include "hw/misc/esp32_fe.h"
+
+#define DEBUG 0
+
+static uint64_t esp32_fe_read(void *opaque, hwaddr addr, unsigned int size)
+{
+    uint32_t r = 0;
+    Esp32FeState *s = ESP32_FE(opaque);
+    r=s->mem[addr/4];
+    switch(addr){
+      case 0x174:
+      case 0x7C:
+        r=0xffffffff;
+        break;
+    }
+    if(DEBUG) printf("esp32_fe_read  0x%04lx= 0x%08x\n",(unsigned long) addr,r);
+    
+    return r;
+}
+
+static void esp32_fe_write(void *opaque, hwaddr addr, uint64_t value,
+                                 unsigned int size) {
+  Esp32FeState *s = ESP32_FE(opaque);
+  if(DEBUG) printf("esp32_fe_write 0x%04lx= 0x%08lx\n",(unsigned long) addr, (unsigned long) value);
+
+  s->mem[addr/4]=(uint32_t)value;
+}
+
+static const MemoryRegionOps esp32_fe_ops = {
+    .read =  esp32_fe_read,
+    .write = esp32_fe_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+};
+
+static void esp32_fe_init(Object *obj)
+{
+    Esp32FeState *s = ESP32_FE(obj);
+    SysBusDevice *sbd = SYS_BUS_DEVICE(obj);
+
+    memory_region_init_io(&s->iomem, obj, &esp32_fe_ops, s,
+                          TYPE_ESP32_FE, 0x1000);
+    sysbus_init_mmio(sbd, &s->iomem);
+    memset(s->mem,0,sizeof(s->mem));
+}
+
+
+static const TypeInfo esp32_fe_info = {
+    .name = TYPE_ESP32_FE,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(Esp32FeState),
+    .instance_init = esp32_fe_init,
+};
+
+static void esp32_fe_register_types(void)
+{
+    type_register_static(&esp32_fe_info);
+}
+
+type_init(esp32_fe_register_types)
