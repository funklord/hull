diff --git a/hw/ssi/esp32s3_gpspi.c b/hw/ssi/esp32s3_gpspi.c
new file mode 100644
index 0000000..1f33e46
--- /dev/null
+++ b/hw/ssi/esp32s3_gpspi.c
@@ -0,0 +1,221 @@
+/*
+ * esp32s3_gpspi.c -- the ESP32-S3's GPSPI2 as a master: a user command
+ * (SPI_CMD's USR) runs its phases in order, each a byte at a time on the
+ * bus -- the command's (SPI_USER2, its low byte first), the address's
+ * (SPI_ADDR, its high bits first), the data's, out of W0-W15 and back into
+ * them full duplex, W8 on where a HIGHPART bit says -- with CS0 asserted
+ * unless MISC disables it, and released after unless CS_KEEP_ACTIVE.
+ * Then USR clears and TRANS_DONE is raised. Registers per ESP-IDF's
+ * soc/esp32s3/register/soc/spi_reg.h; no DMA, no slave mode.
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/module.h"
+#include "hw/irq.h"
+#include "hw/sysbus.h"
+#include "hw/ssi/ssi.h"
+#include "hw/ssi/esp32s3_gpspi.h"
+
+#define CMD        (0x00 / 4)
+#define ADDR       (0x04 / 4)
+#define USER       (0x10 / 4)
+#define USER1      (0x14 / 4)
+#define USER2      (0x18 / 4)
+#define MS_DLEN    (0x1c / 4)
+#define MISC       (0x20 / 4)
+#define INT_ENA    (0x34 / 4)
+#define INT_CLR    (0x38 / 4)
+#define INT_RAW    (0x3c / 4)
+#define INT_ST     (0x40 / 4)
+#define INT_SET    (0x44 / 4)
+#define W0         (0x98 / 4)
+#define DATE       (0xf0 / 4)
+
+#define CMD_USR          (1u << 24)
+#define CMD_UPDATE       (1u << 23)
+#define USER_COMMAND     (1u << 31)
+#define USER_ADDR        (1u << 30)
+#define USER_MISO        (1u << 28)
+#define USER_MOSI        (1u << 27)
+#define USER_MOSI_HIGH   (1u << 25)
+#define USER_MISO_HIGH   (1u << 24)
+#define MISC_CS_KEEP     (1u << 30)
+#define TRANS_DONE       (1u << 12)
+
+static void gpspi_update_irq(Esp32s3GpspiState *s)
+{
+    s->regs[INT_ST] = s->regs[INT_RAW] & s->regs[INT_ENA];
+    qemu_set_irq(s->irq, s->regs[INT_ST] != 0);
+}
+
+/* A byte of W0-W15 by its index from `base`, little-endian in each word. */
+static uint8_t w_get(Esp32s3GpspiState *s, unsigned base, unsigned i)
+{
+    unsigned at = base + i;
+
+    return at < 64 ? (uint8_t)(s->regs[W0 + at / 4] >> (8 * (at % 4))) : 0;
+}
+
+static void w_set(Esp32s3GpspiState *s, unsigned base, unsigned i, uint8_t v)
+{
+    unsigned at = base + i;
+
+    if (at < 64) {
+        uint32_t *w = &s->regs[W0 + at / 4];
+
+        *w = (*w & ~(0xffu << (8 * (at % 4)))) | ((uint32_t)v << (8 * (at % 4)));
+    }
+}
+
+static void gpspi_select(Esp32s3GpspiState *s, int on)
+{
+    uint32_t misc = s->regs[MISC];
+
+    for (unsigned i = 0; i < 6; i++) {
+        if (!(misc & (1u << i))) {
+            qemu_set_irq(s->cs[i], on ? 0 : 1);   /* active low */
+        }
+    }
+}
+
+static void gpspi_transaction(Esp32s3GpspiState *s)
+{
+    uint32_t user = s->regs[USER];
+
+    gpspi_select(s, 1);
+    if (user & USER_COMMAND) {
+        unsigned bits = ((s->regs[USER2] >> 28) & 0xf) + 1;
+        uint32_t value = s->regs[USER2] & 0xffff;
+
+        for (unsigned i = 0; i < (bits + 7) / 8; i++) {
+            ssi_transfer(s->spi, (value >> (8 * i)) & 0xff);
+        }
+    }
+    if (user & USER_ADDR) {
+        unsigned bits = ((s->regs[USER1] >> 27) & 0x1f) + 1;
+        unsigned bytes = (bits + 7) / 8;
+        uint32_t value = s->regs[ADDR];
+
+        for (unsigned i = 0; i < bytes; i++) {
+            ssi_transfer(s->spi, (value >> (8 * (bytes - 1 - i))) & 0xff);
+        }
+    }
+    if (user & (USER_MOSI | USER_MISO)) {
+        unsigned bytes = ((s->regs[MS_DLEN] & 0x3ffff) + 1 + 7) / 8;
+        unsigned out_base = (user & USER_MOSI_HIGH) ? 32 : 0;
+        unsigned in_base = (user & USER_MISO_HIGH) ? 32 : 0;
+
+        for (unsigned i = 0; i < bytes; i++) {
+            uint8_t out = (user & USER_MOSI) ? w_get(s, out_base, i) : 0xff;
+            uint8_t in = (uint8_t)ssi_transfer(s->spi, out);
+
+            if (user & USER_MISO) {
+                w_set(s, in_base, i, in);
+            }
+        }
+    }
+    if (!(s->regs[MISC] & MISC_CS_KEEP)) {
+        gpspi_select(s, 0);
+    }
+    s->regs[CMD] &= ~CMD_USR;
+    s->regs[INT_RAW] |= TRANS_DONE;
+    gpspi_update_irq(s);
+}
+
+static uint64_t gpspi_read(void *opaque, hwaddr addr, unsigned size)
+{
+    Esp32s3GpspiState *s = ESP32S3_GPSPI(opaque);
+
+    if (addr / 4 == DATE) {
+        return 0x2101190;
+    }
+    return addr / 4 < ESP32S3_GPSPI_REGS ? s->regs[addr / 4] : 0;
+}
+
+static void gpspi_write(void *opaque, hwaddr addr, uint64_t value, unsigned size)
+{
+    Esp32s3GpspiState *s = ESP32S3_GPSPI(opaque);
+    unsigned reg = addr / 4;
+
+    if (reg >= ESP32S3_GPSPI_REGS) {
+        return;
+    }
+    switch (reg) {
+    case CMD:
+        /* UPDATE syncs the registers to the SPI clock domain at once. */
+        s->regs[CMD] = (uint32_t)value & ~CMD_UPDATE;
+        if (value & CMD_USR) {
+            gpspi_transaction(s);
+        }
+        break;
+    case INT_CLR:
+        s->regs[INT_RAW] &= ~(uint32_t)value;
+        gpspi_update_irq(s);
+        break;
+    case INT_SET:
+        s->regs[INT_RAW] |= (uint32_t)value;
+        gpspi_update_irq(s);
+        break;
+    case INT_ENA:
+        s->regs[INT_ENA] = (uint32_t)value;
+        gpspi_update_irq(s);
+        break;
+    case INT_RAW:
+    case INT_ST:
+        break;
+    default:
+        s->regs[reg] = (uint32_t)value;
+        break;
+    }
+}
+
+static const MemoryRegionOps gpspi_ops = {
+    .read = gpspi_read,
+    .write = gpspi_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid.min_access_size = 4,
+    .valid.max_access_size = 4,
+};
+
+static void gpspi_reset(DeviceState *dev)
+{
+    Esp32s3GpspiState *s = ESP32S3_GPSPI(dev);
+
+    memset(s->regs, 0, sizeof s->regs);
+    s->regs[MISC] = 0x3e;   /* CS1-CS5 disabled, CS0 in use, as at reset */
+    gpspi_update_irq(s);
+}
+
+static void gpspi_init(Object *obj)
+{
+    Esp32s3GpspiState *s = ESP32S3_GPSPI(obj);
+    SysBusDevice *sbd = SYS_BUS_DEVICE(obj);
+
+    memory_region_init_io(&s->iomem, obj, &gpspi_ops, s, TYPE_ESP32S3_GPSPI, 0x1000);
+    sysbus_init_mmio(sbd, &s->iomem);
+    sysbus_init_irq(sbd, &s->irq);
+    s->spi = ssi_create_bus(DEVICE(s), "spi");
+    qdev_init_gpio_out_named(DEVICE(s), s->cs, SSI_GPIO_CS, 6);
+}
+
+static void gpspi_class_init(ObjectClass *klass, void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+
+    device_class_set_legacy_reset(dc, gpspi_reset);
+}
+
+static const TypeInfo gpspi_info = {
+    .name = TYPE_ESP32S3_GPSPI,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(Esp32s3GpspiState),
+    .instance_init = gpspi_init,
+    .class_init = gpspi_class_init,
+};
+
+static void gpspi_register_types(void)
+{
+    type_register_static(&gpspi_info);
+}
+
+type_init(gpspi_register_types)
