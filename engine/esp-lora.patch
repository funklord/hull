+/*
+ * An SX1276 on the VSPI bus, SPI3, as a Heltec WiFi LoRa 32 and a TTGO
+ * LoRa32 wire one: its NSS on a GPIO the firmware drives, as Arduino's
+ * LoRa libraries do rather than by the controller's own CS, its NRESET on
+ * another, its DIO0 on a third that the firmware reads. Heltec's pins,
+ * 18, 14 and 26, unless lora-pins names others.
+ */
+static void esp32_machine_init_lora(Esp32MachineState *ms, Esp32SocState *ss)
+{
+    unsigned nss = 18, nreset = 14, dio0 = 26;
+    Chardev *air = qemu_chr_find(ms->lora);
+    DeviceState *radio;
+    BusState *bus = qdev_get_child_bus(DEVICE(&ss->spi[3]), "spi");
+
+    if (!air) {
+        error_report("lora: no chardev %s", ms->lora);
+        exit(1);
+    }
+    if (ms->lora_pins &&
+        (sscanf(ms->lora_pins, "%u:%u:%u", &nss, &nreset, &dio0) != 3 ||
+         nss > 31 || nreset > 31 || dio0 > 31)) {
+        error_report("lora-pins: NSS:NRESET:DIO0, each a GPIO below 32");
+        exit(1);
+    }
+    radio = qdev_new("sx127x");
+    qdev_prop_set_chr(radio, "chardev", air);
+    qdev_realize_and_unref(radio, bus, &error_fatal);
+    qdev_connect_gpio_out_named(DEVICE(&ss->gpio), "out", nss,
+                                qdev_get_gpio_in_named(radio, SSI_GPIO_CS, 0));
+    qdev_connect_gpio_out_named(DEVICE(&ss->gpio), "out", nreset,
+                                qdev_get_gpio_in_named(radio, "reset", 0));
+    qdev_connect_gpio_out_named(radio, "dio0", 0,
+                                qdev_get_gpio_in_named(DEVICE(&ss->gpio), "in", dio0));
+    /* NSS high, the radio unselected, until the firmware drives it. */
+    qemu_set_irq(qdev_get_gpio_in_named(radio, SSI_GPIO_CS, 0), 1);
+}
