+/* The radio's blocks ESP-IDF's WiFi driver reads and no model has: each
+ * reads back its value, all ones or zero as the driver's calibration waits
+ * for, and takes writes, as lcgamboa's picsimlab-esp32 maps them. */
+static uint64_t radio_stub_read(void *opaque, hwaddr addr, unsigned size)
+{
+    return (uint32_t)(uintptr_t)opaque;
+}
+
+static void radio_stub_write(void *opaque, hwaddr addr, uint64_t value, unsigned size)
+{
+}
+
+static const MemoryRegionOps radio_stub_ops = {
+    .read = radio_stub_read,
+    .write = radio_stub_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+};
+
+static void esp32_soc_add_radio_stub(MemoryRegion *dest, const char *name, hwaddr base,
+                                     uint32_t value)
+{
+    MemoryRegion *mr = g_new(MemoryRegion, 1);
+
+    MemoryRegion *apb = g_new(MemoryRegion, 1);
