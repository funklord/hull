// A Hull pack (project.md section 3.13), the byte layout store/pack.c
// writes and reads: a stored tree's manifest and every object it names,
// each compressed alone as a zstd frame, behind an index upfront, so that
// one object is found and read without the rest. Every number is
// big-endian. The manifest, once decompressed, is manifest/manifest.situ's.
//
// A pack made against a base may hold an object as a recipe against the
// base's object at the same path, its flags' bit 2 set and its frame the
// recipe compressed (store/pack.c says the recipe); such a pack is
// version 2, any other version 1.
//
// The index's digests ascend, each once, and each frame lies inside the
// data, its offset counted from the data's start: `room` is the data's
// length, what remains after the index and the manifest's frame. The
// manifest and its frame are at most 256 MiB, as store/pack.c reads them.
//
// WHAT THIS SCHEMA DOES NOT SAY, and hull checks instead (store/pack.c):
// - that a frame decompresses to its object's length and its object to
//   its digest, and the manifest's frame to the manifest's length and to
//   the hash the pack is known by.

target buffer;
endian big;

// One object: its sha256, whether it is executable (1) and whether it is
// a recipe (2), its length once decompressed, and where its frame lies in the data and how long it is.
struct index_entry {
	parameter i64 room;
	u8  digest[32];
	u8  flags   [max = 3];
	u64 length;
	u64 offset;
	u64 frame;
}
when index_entry.offset + index_entry.frame > index_entry.room
	refuse frame_outside_data "a frame lies past the end of the data";

struct pack {
	preamble u8[8] = "HULLPACK";
	u32 version          [min = 1, max = 2];
	u32 count            [max = 0x400000];
	u64 manifest_length  [max = 0x10000000];
	u64 manifest_frame   [max = 0x10000000];
	index_entry(room = remaining - count * 57 - manifest_frame) index[count] [ascending = digest];
	u8  manifest[manifest_frame];
	u8  data[remaining];
}
