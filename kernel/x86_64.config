# hull's own kernel for a vm on x86_64 (project.md Appendix F): tinyconfig
# and this, merged by the kernel's scripts/kconfig/merge_config.sh. Every
# driver a hull vm uses is built in, so the kernel needs no modules: the
# engine's initramfs then carries the agent alone. Each group says what in
# hull needs it.

# 64-bit, SMP, and a KVM guest's clock and paravirt.
CONFIG_64BIT=y
CONFIG_SMP=y
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_KVM_GUEST=y
# ACPI, by which a q35 machine powers off when the agent ends it: without
# it the guest halts and qemu runs on, measured, until killed.
CONFIG_ACPI=y
CONFIG_X86_X2APIC=y
CONFIG_NO_HZ_IDLE=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_PRINTK=y
CONFIG_BUG=y
CONFIG_MULTIUSER=y
CONFIG_POSIX_TIMERS=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_SHMEM=y
CONFIG_AIO=y
CONFIG_FILE_LOCKING=y
CONFIG_FHANDLE=y
CONFIG_INOTIFY_USER=y
CONFIG_ADVISE_SYSCALLS=y
CONFIG_MEMBARRIER=y
CONFIG_RSEQ=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y

# The initramfs the engine writes, an uncompressed newc archive.
CONFIG_BLK_DEV_INITRD=y

# The console: hvc0 on virtio-serial, and a serial port for the earliest.
CONFIG_TTY=y
CONFIG_UNIX98_PTYS=y
# CONFIG_VT is not set
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_HVC_DRIVER=y

# virtio over PCI, as q35 gives every device.
CONFIG_PCI=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_VIRTIO=y

# The network: passt's eth0, segments' NICs, IPv4 and IPv6, and vsock to
# the host for the agent.
CONFIG_NET=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_UNIX=y
CONFIG_PACKET=y
CONFIG_NETDEVICES=y
CONFIG_NET_CORE=y
CONFIG_VIRTIO_NET=y
CONFIG_VSOCKETS=y
CONFIG_VIRTIO_VSOCKETS=y

# The root and volumes: 9p shares, a disk for a block projection or an
# image volume, an overlay above, composefs's erofs.
CONFIG_NET_9P=y
CONFIG_NET_9P_VIRTIO=y
CONFIG_NETWORK_FILESYSTEMS=y
CONFIG_9P_FS=y
CONFIG_FUSE_FS=y
CONFIG_VIRTIO_FS=y
CONFIG_9P_FS_POSIX_ACL=y
CONFIG_BLOCK=y
CONFIG_VIRTIO_BLK=y
CONFIG_EXT4_FS=y
CONFIG_OVERLAY_FS=y
CONFIG_MISC_FILESYSTEMS=y
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_XATTR=y
CONFIG_EROFS_FS_BACKED_BY_FILE=y
# fs-verity, for (security (verity true)): ext4 enables it on the objects
# disk and overlayfs checks each file against the image (section 3.2).
CONFIG_FS_VERITY=y
CONFIG_TMPFS=y
CONFIG_TMPFS_XATTR=y
CONFIG_DEVTMPFS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y

# What a workload commonly asks of its kernel: namespaces (an
# `unshare -rn` in a vm, measured working on the host's kernel), cgroups,
# seccomp.
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_CGROUPS=y
CONFIG_SECCOMP=y
CONFIG_SYSVIPC=y
