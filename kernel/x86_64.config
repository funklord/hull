# hull's own kernel on x86_64 (project.md Appendix F): what is x86's,
# merged after kernel/common.config.

# 64-bit, and a KVM guest's clock and paravirt.
CONFIG_64BIT=y
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_KVM_GUEST=y
# ACPI, by which a q35 machine powers off when the agent ends it: without
# it the guest halts and qemu runs on, measured, until killed.
CONFIG_ACPI=y
CONFIG_X86_X2APIC=y

# A serial port for the earliest console.
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y

# A microvm (project.md section 5.2): no PCI there, so every device is on
# virtio-mmio, which qemu describes by ACPI, and it enters the kernel
# directly by PVH.
CONFIG_VIRTIO_MMIO=y
CONFIG_PVH=y

# A vm in a vm: KVM, and vhost-vsock for the nested machine's agent, as
# modules. A guest on Debian's kernel had them; one on hull's could not
# host a vm, so check-vhost's outer machine, which needs gpio-sim (hull's
# alone), could not start its nested one (2026-11-20).
CONFIG_VIRTUALIZATION=y
CONFIG_KVM=m
CONFIG_KVM_INTEL=m
CONFIG_KVM_AMD=m
CONFIG_VHOST_MENU=y
CONFIG_VHOST_VSOCK=m
