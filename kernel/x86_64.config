# hull's own kernel on x86_64 (project.md Appendix F): what is x86's,
# merged after kernel/common.config.

# 64-bit, and a KVM guest's clock and paravirt.
CONFIG_64BIT=y
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_KVM_GUEST=y
# ACPI, by which a q35 machine powers off when the agent ends it: without
# it the guest halts and qemu runs on, measured, until killed.
CONFIG_ACPI=y
CONFIG_X86_X2APIC=y

# A serial port for the earliest console.
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y

# A microvm (project.md section 5.2): no PCI there, so every device is on
# virtio-mmio, which qemu describes by ACPI, and it enters the kernel
# directly by PVH.
CONFIG_VIRTIO_MMIO=y
CONFIG_PVH=y
