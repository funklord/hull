# hull's own kernel on arm64 (project.md Appendix F), for an arm64 machine
# under emu, qemu's virt: what is arm64's, merged after
# kernel/common.config. The GIC, the architected timer and PSCI, by which
# the agent's power-off ends the machine, come with the architecture.

# virt's PCIe host bridge, which every virtio device is behind.
CONFIG_PCI_HOST_GENERIC=y
# Its PL011 UART, for the earliest console.
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
