		sh test/board_test.sh '$(HULL)' '$(BOARD_AVR)' '$(BOARD_ARM)' \
		'$(BOARD_8051)' $(strip $(BOARD_ESP))

$(BUILD_DIR)/test/board-fw/echo_avr.elf: test/board/echo_avr.c
	@mkdir -p '$(@D)'
	$(BOARD_AVR_CC) -mmcu=atmega328p -Os -Wall -Wextra -o $@ $<

$(BUILD_DIR)/test/board-fw/echo_stm32.elf: test/board/echo_stm32.c test/board/stm32f100.ld
	@mkdir -p '$(@D)'
	$(BOARD_ARM_CC) --target=thumbv7m-none-eabi -mcpu=cortex-m3 -mthumb -ffreestanding -nostdlib \
		-Os -Wall -Wextra -c -o $(@D)/echo_stm32.o $<
	$(BOARD_ARM_LD) -T test/board/stm32f100.ld --entry=reset -o $@ $(@D)/echo_stm32.o

$(BUILD_DIR)/test/board-fw/echo_8051.ihx: test/board/echo_8051.c
	@mkdir -p '$(@D)'
	$(SDCC) -mmcs51 -o $(@D)/ $<

# An ESP32 test image: NAME, LOAD, CHIP-ID, BOOT-OFFSET, and UART0 for
# the RISC-V ones or the assembler's define for the Xtensa ones.
define esp_rv_rule
$$(BUILD_DIR)/test/board-fw/$(1).flash: test/board/echo_esp_rv.c test/board/esp_image.py
	@mkdir -p '$$(@D)'
	$$(BOARD_ARM_CC) --target=riscv32 -march=rv32imc -mabi=ilp32 -ffreestanding -nostdlib -fno-pic \
		-Os -Wall -Wextra -DUART=$(5)u -c -o $$(@D)/$(1).o $$<
	$$(BOARD_ARM_LD) -Ttext=$(2) --entry=start -o $$(@D)/$(1).elf $$(@D)/$(1).o
	$$(BOARD_OBJCOPY) -O binary $$(@D)/$(1).elf $$(@D)/$(1).bin
	$$(PYTHON) test/board/esp_image.py $$(@D)/$(1).bin $(2) $(3) $(4) $$@
endef
define esp_xt_rule
$$(BUILD_DIR)/test/board-fw/$(1).flash: test/board/echo_esp_xt.S test/board/esp_image.py
	@mkdir -p '$$(@D)'
	$$(BOARD_ARM_CC) -E -P -x assembler-with-cpp $(5) -o $$(@D)/$(1).s $$<
	$$(BOARD_MC) -triple=xtensa -filetype=obj -o $$(@D)/$(1).o $$(@D)/$(1).s
	$$(BOARD_OBJCOPY) -O binary -j .text $$(@D)/$(1).o $$(@D)/$(1).bin
	$$(PYTHON) test/board/esp_image.py $$(@D)/$(1).bin $(2) $(3) $(4) $$@
endef
# A Heltec's LoRa firmware, FIRST sending the ping, the other hearing it by
# DIO0's interrupt, by Espressif's GCC: its code in IRAM, its constants in
# DRAM, entered at start.
$(BUILD_DIR)/test/board-fw/lora-%.flash: test/board/lora_esp32.c test/board/esp32_ram.ld test/board/esp_image.py
	@mkdir -p '$(@D)'
	$(BOARD_XTENSA_CC) -Os -Wall -Wextra -ffreestanding -nostdlib -nostartfiles -fno-builtin \
		$(if $(filter first,$*),-DFIRST,-DIRQ) -T test/board/esp32_ram.ld -o $(@D)/lora-$*.elf $<
	$(BOARD_XTENSA_BIN)-objcopy -O binary -j .text $(@D)/lora-$*.elf $(@D)/lora-$*.text
	$(BOARD_XTENSA_BIN)-objcopy -O binary -j .data $(@D)/lora-$*.elf $(@D)/lora-$*.data
	$(PYTHON) test/board/esp_image.py $(@D)/lora-$*.text 0x40080400 0 0x1000 $@ \
		0x$$($(BOARD_XTENSA_BIN)-nm $(@D)/lora-$*.elf | awk '$$3 == "start" { print $$1 }') \
		$(@D)/lora-$*.data 0x3ffb0000

# Espressif's qemu with hull's SX1276 (engine/esp-lora.patch), for a
# board's (tuning (pc (lora NAME))): its source at the tag hull's fetch
# pins, the commit checked, patched and built for xtensa alone, into
# $(BUILD_DIR)/esp-qemu-lora, where HULL_ESP_LORA_QEMU names it. Not part
# of any other target: it fetches the source, about 200 MB, and builds
# for some minutes.
esp-qemu-lora: $(ESP_QEMU_LORA)

$(ESP_QEMU_LORA): engine/esp-lora.patch
	@mkdir -p '$(BUILD_DIR)/esp-qemu-lora'
	test -d '$(BUILD_DIR)/esp-qemu-lora/src' || git clone -q --depth 1 --branch $(ESP_QEMU_TAG) \
		https://github.com/espressif/qemu.git '$(BUILD_DIR)/esp-qemu-lora/src'
	test "$$(git -C '$(BUILD_DIR)/esp-qemu-lora/src' rev-parse HEAD)" = $(ESP_QEMU_COMMIT)
	git -C '$(BUILD_DIR)/esp-qemu-lora/src' checkout -q -- .
	git -C '$(BUILD_DIR)/esp-qemu-lora/src' clean -q -f -- hw/misc/sx127x.c
	git -C '$(BUILD_DIR)/esp-qemu-lora/src' apply '$(abspath engine/esp-lora.patch)'
	mkdir -p '$(BUILD_DIR)/esp-qemu-lora/build'
	cd '$(BUILD_DIR)/esp-qemu-lora/build' && test -f build.ninja || ../src/configure \
		--target-list=xtensa-softmmu --without-default-features --enable-slirp \
		--enable-gcrypt --disable-werror --disable-docs > configure.log
	ninja -C '$(BUILD_DIR)/esp-qemu-lora/build' -j $(ESP_QEMU_JOBS) qemu-system-xtensa

# The LM3S6965's and the MPS2 AN385's network firmware, as the
# ESP32-C3's: NAT and a wire. BOARD, then NAT or WIRE-END.
define lm3s_net_rule
$$(BUILD_DIR)/test/board-fw/$(1)-net-$(2).elf: test/board/$(1)_net.c test/board/lm3s6965.ld
	@mkdir -p '$$(@D)'
	$$(BOARD_ARM_CC) --target=thumbv7m-none-eabi -mcpu=cortex-m3 -mthumb -ffreestanding -nostdlib \
		-Os -Wall -Wextra $$(ESP_NET_$(2)) -c -o $$(@D)/$(1)-net-$(2).o $$<
	$$(BOARD_ARM_LD) -T test/board/lm3s6965.ld --entry=reset -o $$@ $$(@D)/$(1)-net-$(2).o
endef
$(foreach b,lm3s mps2,$(foreach w,$(LM3S_NETS),$(eval $(call lm3s_net_rule,$(b),$(w)))))
define esp_net_rule
$$(BUILD_DIR)/test/board-fw/esp32c3-net-$(1).flash: test/board/echo_esp_net.c test/board/esp_image.py
	@mkdir -p '$$(@D)'
	$$(BOARD_ARM_CC) --target=riscv32 -march=rv32imc -mabi=ilp32 -ffreestanding -nostdlib -fno-pic \
		-Os -Wall -Wextra $$(ESP_NET_$(1)) -c -o $$(@D)/esp32c3-net-$(1).o $$<
	$$(BOARD_ARM_LD) -Ttext=0x40380000 --entry=start -o $$(@D)/esp32c3-net-$(1).elf \
		$$(@D)/esp32c3-net-$(1).o
	$$(BOARD_OBJCOPY) -O binary $$(@D)/esp32c3-net-$(1).elf $$(@D)/esp32c3-net-$(1).bin
	$$(PYTHON) test/board/esp_image.py $$(@D)/esp32c3-net-$(1).bin 0x40380000 5 0x0 $$@
endef
$(foreach w,$(ESP_NETS),$(eval $(call esp_net_rule,$(w))))
esp_field   = $(word $(2),$(subst :, ,$(1)))
esp_rule    = $(eval $(call $(2),$(call esp_field,$(1),1),$(call esp_field,$(1),2),$(call esp_field,$(1),3),$(call esp_field,$(1),4),$(call esp_field,$(1),5)))
$(foreach c,$(ESP_RV_CHIPS),$(call esp_rule,$(c),esp_rv_rule))
$(foreach c,$(ESP_XT_CHIPS),$(call esp_rule,$(c),esp_xt_rule))

# The indentation and whitespace gate, shared verbatim with the sibling
# projects; `docs` additionally holds project.md to the tree it describes.
style: style-tool style-source style-docs

# The style gate's own suite, run ahead of the gate's verdict. A checker
# that has stopped inspecting anything passes exactly as loudly as one
# that works, so its pass is worth reading only once its suite has.
# tool/test_style_gate.py arrives beside tool/style_gate.py and was
# carried here unrun until 2026-11-12, on the holder's word.
style-tool:
	$(PYTHON) tool/test_style_gate.py

style-source:
	$(PYTHON) tool/style_gate.py check

style-docs:
	$(PYTHON) tool/style_gate.py docs

# What each schema costs -- every field's capability vector -- against the
# committed map beside it. A situ update that changes how a form is framed
# or reached fails here, before it reaches the reader.
contract: $(SITU_MARK)
	$(SITUC) map --check sexpr/readable.situ
	$(SITUC) map --check sexpr/canonical.situ
	$(SITUC) map --check agent/message.situ
	$(SITUC) map --check manifest/manifest.situ
	$(SITUC) map --check agent/protocol.situ
	$(SITUC) map --check core/frontend.situ
	$(SITUC) map --check engine/disc.situ
	$(SITUC) map --check core/frame.situ

hooks:
	@if ! command -v git >/dev/null 2>&1; then \
		echo "hooks: git is not installed, so there is nowhere to install to." >&2; \
		exit 1; \
	fi; \
	dir=$$(git rev-parse --git-common-dir 2>/dev/null); \
	if [ -z "$$dir" ]; then \
		echo "hooks: not a git repository, so there is nowhere to install to." >&2; \
		exit 1; \
	fi; \
	set -e; \
	mkdir -p "$$dir/hooks"; \
	install -m 0755 tool/hooks/commit-msg "$$dir/hooks/commit-msg"; \
	echo "hooks: commit-msg installed from tool/hooks/ into $$dir/hooks/"

# Named files only, each printed as it goes. The directories stay.
clean:
	@rm -fv $(TEST_BINS) $(TEST_OBJS) $(TEST_OBJS:.o=.d) \
	        $(SEXPR_OBJS) $(SEXPR_OBJS:.o=.d) $(GEN_SOURCES) $(GEN_HEADERS) \
	        $(AGENT_OBJS) $(AGENT_OBJS:.o=.d) $(AGENT_GEN) \
	        $(SPEC_OBJS) $(SPEC_OBJS:.o=.d) $(PLAN_OBJS) $(PLAN_OBJS:.o=.d) \
	        $(ENGINE_OBJS) $(ENGINE_OBJS:.o=.d) $(STORE_OBJS) $(STORE_OBJS:.o=.d) $(OCI_OBJS) $(OCI_OBJS:.o=.d) $(CLI_OBJS) $(CLI_OBJS:.o=.d) $(HULL) $(ROOT_BIN) \
	        $(CORE_OBJS) $(CORE_OBJS:.o=.d) $(FRONTEND_GEN) $(PROTOCOL_GEN) $(DISC_GEN) $(FRAME_GEN) \
	        $(AGENT_BIN) $(BUILD_DIR)/hull-agent-arm64 $(BUILD_DIR)/hull-agent-amd64 \
	        $(BUILD_DIR)/hull-agent-riscv64 $(BUILD_DIR)/hull-agent-s390x $(KERNEL_BIN) \
	        $(LIMINE_FILES) \
	        $(BUILD_DIR)/agent/agent.o $(BUILD_DIR)/agent/agent.d $(GEN_DIR)/commit.h \
	        $(CLI_TEST_FILES) $(PROBE) $(BUILD_DIR)/test/arm64/rootfs/probe \
	        $(BUILD_DIR)/test/riscv64/rootfs/probe $(BUILD_DIR)/test/s390x/rootfs/probe \
	        $(DOCKER_TEST_FILES) $(QEMU_TEST_FILES) $(ROOT_TEST_FILES) $(ROOTVM_TEST_FILES) $(SYSTEMD_TEST_FILES) $(VFIO_TEST_FILES) $(USB_TEST_FILES) $(BOARD_TEST_FILES) \
	        $(FUZZ_FILES) \
	        $(FLIP_TEST_FILES) $(NSS_LIB) $(BUILD_DIR)/hull.apparmor $(CLIENT_LIB) $(GUI_BIN) \
	        $(GUI_TEST_FILES)
	@# qmake's builds, each cleaned by its own Makefile, which names its files.
	@# The guard shares the line: make runs a line holding $(MAKE) even under
	@# -n or -t, and a dry run would otherwise clean.
	@case "$(firstword $(MAKEFLAGS))" in -*) ;; *[nt]*) exit 0 ;; esac; \
	for sub in gui test/gui-build test/gui-list qtty; do \
	    if [ -f '$(BUILD_DIR)/'"$$sub"/Makefile ]; then \
	        $(MAKE) -s -C '$(BUILD_DIR)/'"$$sub" distclean; fi; \
	done
	@# check-sanitize's own build, cleaned as this one is, by name; one level
	@# down only, there being no sanitize/sanitize to go on to.
	@if [ -d '$(BUILD_DIR)/sanitize' ]; then $(MAKE) -s BUILD_DIR='$(BUILD_DIR)/sanitize' clean; fi
