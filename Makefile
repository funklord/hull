STORE_OBJS  = $(BUILD_DIR)/store/store.o $(BUILD_DIR)/store/unpack.o $(BUILD_DIR)/store/pack.o
# Section 3.5's border: what `hull pull` reads a registry with.
OCI_OBJS    = $(BUILD_DIR)/oci/json.o $(BUILD_DIR)/oci/https.o $(BUILD_DIR)/oci/remote.o \
              $(BUILD_DIR)/oci/pull.o $(BUILD_DIR)/oci/push.o
# The holder's choice, 2026-10-21 (section 3.5): TLS by OpenSSL, layers by zlib;
# and by section 9's rule, packs by libzstd and a fetched kernel's package by liblzma.
PULL_LIBS   = -lssl -lcrypto -lz -lzstd -llzma

# The per-user core, and the frontend protocol it speaks (section 4.10),
# validated by C situ generates from core/frontend.situ.
FRONTEND_GEN = $(GEN_DIR)/frontend.c $(GEN_DIR)/frontend.h
# The agent protocol (Appendix B), validated in both directions by the
# same wire: the host reads the agent's messages, the agent the host's.
PROTOCOL_GEN = $(GEN_DIR)/protocol.c $(GEN_DIR)/protocol.h
# The frames hull at a segment's .1 reads from machines and writes back
# (Appendix D), each validated before a field is read, from core/frame.situ.
# Its checksum codec is derived, situc gen-derived's frame_derived.c.
FRAME_GEN    = $(GEN_DIR)/frame.c $(GEN_DIR)/frame.h $(GEN_DIR)/frame_edit.h $(GEN_DIR)/frame_build.h \
               $(GEN_DIR)/frame_derived.c
# An ISO9660 image's structures, which engine/iso.c builds a disc's data
# track from (section 3.10), from engine/disc.situ.
DISC_GEN     = $(GEN_DIR)/disc.c $(GEN_DIR)/disc.h $(GEN_DIR)/disc_edit.h $(GEN_DIR)/disc_build.h
WIRE_OBJS    = $(BUILD_DIR)/core/wire.o $(GEN_DIR)/frontend.o $(GEN_DIR)/protocol.o \
               $(BUILD_DIR)/agent/framing.o $(GEN_DIR)/message.o
CORE_OBJS    = $(BUILD_DIR)/core/core.o $(BUILD_DIR)/core/segment.o $(GEN_DIR)/frame.o \
               $(GEN_DIR)/frame_derived.o $(WIRE_OBJS)
HULL        = $(BUILD_DIR)/hull

# The guest agent, PID 1 in a qemu machine: static, since the initramfs
# the engine writes holds nothing else, and beside hull, where the engine
# looks for it.
AGENT_BIN_OBJS = $(BUILD_DIR)/agent/agent.o $(WIRE_OBJS) $(BUILD_DIR)/engine/access.o \
                 $(BUILD_DIR)/engine/stack.o $(BUILD_DIR)/engine/ip6.o $(BUILD_DIR)/engine/nic.o \
                 $(BUILD_DIR)/engine/tree.o $(BUILD_DIR)/engine/user.o
AGENT_BIN      = $(BUILD_DIR)/hull-agent
# The same agent for an arm64 machine under emu, beside it, where a cross
# compiler is installed (ARM64_CC, below): its sources the native one's,
# built from the objects' names, its generated C the same files.
AGENT_SOURCES  = $(patsubst $(BUILD_DIR)/%.o,%.c,$(patsubst $(BUILD_DIR)/situ/situ.o,$(SITU_DIR)/runtime/c/situ.c,$(patsubst $(GEN_DIR)/%.o,$(GEN_DIR)/%.c,$(AGENT_BIN_OBJS) $(SEXPR_OBJS))))

# hull's own kernel for a vm (Appendix F), beside hull as its agent is,
# where `(kernel hull)` boots it: Linux at a pinned stable version, its
# tarball checked against the sha256 kernel.org signs, tinyconfig with
# kernel/common.config and kernel/ARCH.config merged, every driver a hull
# vm needs built in. Its modules, the fragment's set, in modules-hull
# beside it as a root's lib/modules/RELEASE, which the engine shares with
# the guest. arm64's too, for an arm64 machine under emu, where the cross
# compiler is installed: vmlinuz-hull-arm64 and modules-hull-arm64, from a
# source tree of its own. Built by `make kernel` alone, it being a long
# build and a download.
KERNEL_VERSION = 6.12.107
KERNEL_SHA256  = a5f8c5be3fde2d6d9ca14e9631642cf1f44487143f11059da730dcd5892e307a
KERNEL_TAR     = $(BUILD_DIR)/kernel/linux-$(KERNEL_VERSION).tar.xz
KERNEL_SRC     = $(BUILD_DIR)/kernel/linux-$(KERNEL_VERSION)
KERNEL_BIN     = $(BUILD_DIR)/vmlinuz-hull
KERNEL_ELF     = $(BUILD_DIR)/vmlinux-hull
KERNEL_MODULES = $(BUILD_DIR)/modules-hull/lib/modules/$(KERNEL_VERSION)
KERNEL_A64_SRC = $(BUILD_DIR)/kernel-arm64/linux-$(KERNEL_VERSION)
KERNEL_A64_BIN = $(BUILD_DIR)/vmlinuz-hull-arm64
KERNEL_A64_MOD = $(BUILD_DIR)/modules-hull-arm64/lib/modules/$(KERNEL_VERSION)
KERNEL_A64     = ARCH=arm64 CROSS_COMPILE=$(patsubst %gcc,%,$(ARM64_CC))
# What a kernel build stamps from the machine and the clock -- the builder,
# the host, the date, a count of builds in that tree -- fixed, so that two
# builds of one version and one config are the same bytes wherever they
# run (Appendix F's reproducible build). The date is a fixed one.
KERNEL_STAMP   = KBUILD_BUILD_TIMESTAMP='2026-08-29' KBUILD_BUILD_USER=hull \
                 KBUILD_BUILD_HOST=hull KBUILD_BUILD_VERSION=1

# Limine from source (section 3.13), beside hull in limine/, where
# `hull export --bootable` takes it in place of the fetched 11.x UEFI
# loader: 12.x, with its BIOS stages and the tool that installs them, so
# an exported image boots under a BIOS as well. GNU binutils for the
# target tools, the default being LLVM's. Built by `make limine` alone.
LIMINE_VERSION = 12.9.6
