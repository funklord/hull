.PHONY: all kernel limine nss root install-root check check-docker check-pc check-hw check-legacy check-remote check-qemu check-root check-sanitize sanitize-run check-fuzz check-flip test vectors style style-source style-docs contract hooks clean help install-nss install-apparmor FORCE

# The software: hull, and the agent its vm and emu engines boot. The NSS
# module is a helper beside it, which nothing in hull needs to run and
# which is installed apart, as root: `make nss`, or `make install-nss`.
all: $(SEXPR_OBJS) $(AGENT_OBJS) $(SPEC_OBJS) $(PLAN_OBJS) $(HULL) $(AGENT_BIN) $(AGENT_ARM64)

nss: $(NSS_LIB)

root: $(ROOT_BIN)

help:
	@echo 'Targets:'
	@echo '  all       build the libraries, build/hull and its agent (the default)'
	@echo '  limine    build Limine $(LIMINE_VERSION) from source, for BIOS-bootable exports'
	@echo '  kernel    build the vm kernel of hull'"'"'s own, vmlinuz-hull, from Linux $(KERNEL_VERSION)'
	@echo '  nss       build the NSS module, libnss_hull.so.2, for *.hull names'
	@echo '  root      build root mode'"'"'s helper, hull-root'
	@echo '  check     style, the situ contracts, then the tests'
	@echo '  check-docker  hull run on the docker adapter, against the local daemon'
	@echo '  check-qemu    hull run on the qemu engine, as the user, with KVM'
	@echo '  check-pc      a whole PC booting its own media, as the user'
	@echo '  check-legacy  FreeDOS, fetched and pinned, on a pc: screen and ssh door'
	@echo '  check-remote  hull -H over a private sshd on 127.0.0.1'
