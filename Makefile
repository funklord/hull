.PHONY: all nss check check-docker check-qemu check-flip test vectors style style-source style-docs contract hooks clean help install-nss install-apparmor FORCE

# The software: hull, and the agent its vm and emu engines boot. The NSS
# module is a helper beside it, which nothing in hull needs to run and
# which is installed apart, as root: `make nss`, or `make install-nss`.
all: $(SEXPR_OBJS) $(AGENT_OBJS) $(SPEC_OBJS) $(PLAN_OBJS) $(HULL) $(AGENT_BIN)

nss: $(NSS_LIB)

help:
	@echo 'Targets:'
	@echo '  all       build the libraries, build/hull and its agent (the default)'
	@echo '  nss       build the NSS module, libnss_hull.so.2, for *.hull names'
	@echo '  check     style, the situ contracts, then the tests'
	@echo '  check-docker  hull run on the docker adapter, against the local daemon'
	@echo '  check-qemu    hull run on the qemu engine, as the user, with KVM'
	@echo '  check-flip    one hull.conf, rsync'"'"'d, run on docker, vm and emu'
	@echo '  test      build and run the reader tests, the vectors, then the gate'"'"'s'
	@echo '  vectors   the described schemas against bytes they must accept and refuse'
	@echo '  style     the indentation and whitespace gate'
	@echo '  contract  the schemas'"'"' capability maps against the committed ones'
	@echo '  hooks     install the commit-msg hook from tool/hooks/'
	@echo '  install-nss  as root: libnss_hull.so.2 into NSS_LIBDIR, for *.hull names'
	@echo '  install-apparmor  as root: a profile letting hull make user namespaces'
	@echo '  clean     remove what the build made, naming each file'

# Each schema generates a header and a source in one situc run, so both are
# one grouped target and a parallel build runs it once.
$(GEN_DIR)/readable.c $(GEN_DIR)/readable.h &: sexpr/readable.situ $(SITU_COMPILER)
	@mkdir -p '$(GEN_DIR)'
	$(SITUC) build --target c --prefix hull_sexpr_r --out '$(GEN_DIR)' sexpr/readable.situ

# Canonical form is generated at the edit layer, whose build header is
# what the writer appends with. The edit header beside it is not used:
# situ finding 10, it does not compile for a `decimal` member.
$(GEN_DIR)/canonical.c $(GEN_DIR)/canonical.h $(GEN_DIR)/canonical_build.h \
$(GEN_DIR)/canonical_edit.h &: sexpr/canonical.situ $(SITU_COMPILER)
	@mkdir -p '$(GEN_DIR)'
	$(SITUC) build --target c --layer edit --prefix hull_sexpr_c --out '$(GEN_DIR)' sexpr/canonical.situ

$(FRONTEND_GEN) &: core/frontend.situ sexpr/canonical.situ $(SITU_COMPILER)
	@mkdir -p '$(GEN_DIR)'
	$(SITUC) build --target c --prefix hull_frontend --out '$(GEN_DIR)' core/frontend.situ

$(PROTOCOL_GEN) &: agent/protocol.situ sexpr/canonical.situ $(SITU_COMPILER)
	@mkdir -p '$(GEN_DIR)'
	$(SITUC) build --target c --prefix hull_protocol --out '$(GEN_DIR)' agent/protocol.situ

$(AGENT_GEN) &: agent/message.situ $(SITU_COMPILER)
	@mkdir -p '$(GEN_DIR)'
	$(SITUC) build --target c --layer frame --prefix hull_agent --out '$(GEN_DIR)' agent/message.situ

# The generated headers are order-only for hand-written objects: they must
# exist before the first compile, and after that the .d files say when a
# change to one should rebuild what includes it.
$(BUILD_DIR)/sexpr/%.o: sexpr/%.c | $(GEN_HEADERS)
	@mkdir -p '$(@D)'
	$(CC) $(CPPFLAGS) $(CFLAGS) $(WARNINGS) $(DEPFLAGS) -c -o $@ $<

$(BUILD_DIR)/agent/%.o: agent/%.c | $(GEN_HEADERS) $(AGENT_GEN) $(FRONTEND_GEN) $(PROTOCOL_GEN)
	@mkdir -p '$(@D)'
	$(CC) $(CPPFLAGS) $(CFLAGS) $(WARNINGS) $(DEPFLAGS) -c -o $@ $<

$(BUILD_DIR)/spec/%.o: spec/%.c | $(GEN_HEADERS)
	@mkdir -p '$(@D)'
	$(CC) $(CPPFLAGS) $(CFLAGS) $(WARNINGS) $(DEPFLAGS) -c -o $@ $<

$(BUILD_DIR)/plan/%.o: plan/%.c | $(GEN_HEADERS)
	@mkdir -p '$(@D)'
	$(CC) $(CPPFLAGS) $(CFLAGS) $(WARNINGS) $(DEPFLAGS) -c -o $@ $<

$(BUILD_DIR)/engine/%.o: engine/%.c | $(GEN_HEADERS) $(AGENT_GEN)
	@mkdir -p '$(@D)'
	$(CC) $(CPPFLAGS) $(CFLAGS) $(WARNINGS) $(DEPFLAGS) -c -o $@ $<

$(BUILD_DIR)/store/%.o: store/%.c | $(GEN_HEADERS)
	@mkdir -p '$(@D)'
	$(CC) $(CPPFLAGS) $(CFLAGS) $(WARNINGS) $(DEPFLAGS) -c -o $@ $<

$(BUILD_DIR)/oci/%.o: oci/%.c
	@mkdir -p '$(@D)'
	$(CC) $(CPPFLAGS) $(CFLAGS) $(WARNINGS) $(DEPFLAGS) -c -o $@ $<

$(BUILD_DIR)/core/%.o: core/%.c VERSION | $(GEN_HEADERS) $(AGENT_GEN) $(FRONTEND_GEN) \
                                          $(PROTOCOL_GEN)
	@mkdir -p '$(@D)'
	$(CC) $(CPPFLAGS) -DHULL_VERSION='"$(VERSION)"' $(CFLAGS) $(WARNINGS) $(DEPFLAGS) -c -o $@ $<

# The commit hull is built from, for --version, so that a result can name
# the hull it rested on without guessing from where the binary sits. The
# rule runs every time and replaces the file only when what it says
# changes: a new commit rebuilds what prints it, and nothing else, where
# a -D flag alone would leave an object naming an old one. -dirty where the
# tree had changes of anybody's, as it was built from those.
$(GEN_DIR)/commit.h: FORCE
	@mkdir -p '$(@D)'
	@commit=$$(git describe --always --dirty --abbrev=12 2>/dev/null || echo unknown); \
	printf '#define HULL_COMMIT "%s"\n' "$$commit" > '$@.new'; \
	if cmp -s '$@.new' '$@'; then rm -f '$@.new'; else mv '$@.new' '$@'; fi

FORCE:

$(BUILD_DIR)/cli/hull.o: $(GEN_DIR)/commit.h
# The core reports this commit in its hello, so a newer frontend sees a
# core left from an older build; it must rebuild when the commit changes.
$(BUILD_DIR)/core/core.o: $(GEN_DIR)/commit.h
# The agent says it too, so a vm's result can name the agent it ran under.
$(BUILD_DIR)/agent/agent.o: $(GEN_DIR)/commit.h

# The version is a prerequisite, so a new number rebuilds what prints it.
$(BUILD_DIR)/cli/%.o: cli/%.c VERSION | $(GEN_HEADERS) $(AGENT_GEN) $(FRONTEND_GEN)
	@mkdir -p '$(@D)'
	$(CC) $(CPPFLAGS) -DHULL_VERSION='"$(VERSION)"' $(CFLAGS) $(WARNINGS) $(DEPFLAGS) -c -o $@ $<

$(PROBE): test/probe.c
	@mkdir -p '$(@D)'
	$(CC) -static $(CFLAGS) -o $@ $<

$(HULL): $(CLI_OBJS) $(CORE_OBJS) $(ENGINE_OBJS) $(STORE_OBJS) $(OCI_OBJS) $(PLAN_OBJS) \
         $(SPEC_OBJS) $(SEXPR_OBJS)
	$(CC) $(CFLAGS) -pthread -o $@ $^ $(PULL_LIBS)

$(AGENT_BIN): $(AGENT_BIN_OBJS) $(SEXPR_OBJS)
	$(CC) -static $(CFLAGS) -o $@ $^

# One file, its own: only the _nss_hull_ entry points are visible.
$(NSS_LIB): nss/nss_hull.c
	@mkdir -p '$(@D)'
	$(CC) $(CFLAGS) $(WARNINGS) -fPIC -fvisibility=hidden -shared -Wl,-soname,libnss_hull.so.2 \
	      -o $@ $<

# The one step of section 8.1's names that needs root, and the only target
# that writes outside the tree: run it as root, then put `hull` on the
# hosts line of /etc/nsswitch.conf, before `dns`.
install-nss: $(NSS_LIB)
	install -D -m 0644 $(NSS_LIB) '$(DESTDIR)$(NSS_LIBDIR)/libnss_hull.so.2'

# The AppArmor profile that lets hull make user namespaces where a host
# restricts them (Ubuntu 24.04). It attaches by the binary's path, and hull
# runs from where it is built, so the path is filled in from HULL_BIN (the
# built binary by default; set it to the installed one). Placing the file is
# all this does; `apparmor_parser -r` loads it, as the recipe says.
APPARMOR_DIR ?= /etc/apparmor.d
HULL_BIN     ?= $(HULL)
install-apparmor: packaging/apparmor/hull.in
	sed 's|@HULL@|$(abspath $(HULL_BIN))|' $< > '$(BUILD_DIR)/hull.apparmor'
	install -D -m 0644 '$(BUILD_DIR)/hull.apparmor' '$(DESTDIR)$(APPARMOR_DIR)/hull'
	@echo 'installed $(DESTDIR)$(APPARMOR_DIR)/hull for $(abspath $(HULL_BIN))'
	@echo 'load it (as root): apparmor_parser -r $(DESTDIR)$(APPARMOR_DIR)/hull'

$(GEN_DIR)/%.o: $(GEN_DIR)/%.c
	$(CC) $(CPPFLAGS) $(CFLAGS) $(WARNINGS) $(DEPFLAGS) -c -o $@ $<

$(BUILD_DIR)/situ/situ.o: $(SITU_DIR)/runtime/c/situ.c
	@mkdir -p '$(@D)'
	$(CC) $(CPPFLAGS) $(CFLAGS) $(WARNINGS) $(DEPFLAGS) -c -o $@ $<

$(BUILD_DIR)/test/%.o: test/%.c | $(GEN_HEADERS) $(AGENT_GEN)
	@mkdir -p '$(@D)'
	$(CC) $(CPPFLAGS) $(CFLAGS) $(WARNINGS) $(DEPFLAGS) -c -o $@ $<

