# hull -- the s-expression reader is the first code (sexpr/), generated in
# part by situ from two schemas; the design is project.md. This Makefile
# builds the reader, runs the checks and installs the git hook.

PYTHON    ?= python3
# Each function and datum a section of its own, and the linker keeping only
# what is reached: -Os works a function at a time and cannot see the rest.
CFLAGS    ?= -Os -g -ffunction-sections -fdata-sections -Wl,--gc-sections
WARNINGS   = -std=c11 -Wall -Wextra -Wconversion -Wsign-conversion
DEPFLAGS   = -MMD -MP
BUILD_DIR ?= build

# --- situ, vendored ---------------------------------------------------------
#
# A submodule pinned to a commit situ's remote has, called by its path and
# never through PATH: the packaged situc of 2026-08-05 prints the same
# `situc 1.0` as the source tree does, so nothing could tell an old one was
# running.
SITU_DIR  = vendor/situ
SITU_MARK = $(SITU_DIR)/bin/situc
SITUC     = $(PYTHON) $(SITU_MARK)

# What generated code depends on: the whole compiler, not only the script
# that starts it. Moving the pin to a situ whose code generator changed and
# whose bin/situc did not regenerated nothing when only the script was
# named, and the suite then passed against code the old situ had written.
SITU_COMPILER = $(SITU_MARK) $(wildcard $(SITU_DIR)/situc/*.py \
                $(SITU_DIR)/situc/*/*.py $(SITU_DIR)/situc/*/*/*.py)

# Fetched on demand, and only for goals that need it: `style`, `clean`,
# `help` and `hooks` must work in a tree whose submodule was never
# initialised. MAKECMDGOALS is empty for a bare `make`, which does need it.
#
# A no-write mode (-n, -q, -t) never fetches, because a dry run is how
# somebody finds out what a target does BEFORE letting it do anything. git
# is asked with `rev-parse` rather than by looking for a `.git` directory,
# which is a file in a worktree or a submodule checkout. Shape taken from
# raidcfgd's aea68a4.
MAKE_SHORT_FLAGS := $(filter-out -%,$(firstword $(MAKEFLAGS)))
NO_WRITE := $(findstring n,$(MAKE_SHORT_FLAGS))$(findstring q,$(MAKE_SHORT_FLAGS))$(findstring t,$(MAKE_SHORT_FLAGS))

SUBMODULE_FETCH_SH = \
	if [ -n "$(NO_WRITE)" ]; then \
		echo "make: $(1)/ is empty, and -n, -q and -t do not fetch it," >&2; \
		echo "make: so this describes a build that cannot run yet." >&2; \
	elif ! command -v git >/dev/null 2>&1; then \
		echo "make: $(1)/ is empty and git is not installed." >&2; \
	elif [ -z "$$(git rev-parse --git-common-dir 2>/dev/null)" ]; then \
		echo "make: $(1)/ is empty and this is not a git checkout," >&2; \
		echo "make: so the vendored $(2) cannot be fetched." >&2; \
	else \
		echo "make: fetching the $(1) submodule" >&2; \
		git submodule update --init $(1) >&2; \
	fi

SITU_FREE_GOALS = help style style-source style-docs hooks clean
ifneq ($(filter-out $(SITU_FREE_GOALS),$(or $(MAKECMDGOALS),all)),)
ifeq ($(wildcard $(SITU_MARK)),)
SITU_FETCH := $(shell $(call SUBMODULE_FETCH_SH,$(SITU_DIR),situ))
# Fail rather than build less: the reader is generated by situ, and there
# is no build of it without situ.
ifeq ($(NO_WRITE),)
ifeq ($(wildcard $(SITU_MARK)),)
$(error $(SITU_DIR) could not be fetched, and the reader cannot be generated without it)
endif
endif
endif
endif

# --- the reader -------------------------------------------------------------

GEN_DIR     = $(BUILD_DIR)/gen
SCHEMAS     = sexpr/readable.situ sexpr/canonical.situ
GEN_SOURCES = $(GEN_DIR)/readable.c $(GEN_DIR)/canonical.c
GEN_HEADERS = $(GEN_DIR)/readable.h $(GEN_DIR)/canonical.h \
              $(GEN_DIR)/canonical_build.h $(GEN_DIR)/canonical_edit.h

SEXPR_OBJS = $(BUILD_DIR)/sexpr/sexpr.o $(BUILD_DIR)/sexpr/writer.o \
             $(BUILD_DIR)/sexpr/convert.o \
             $(GEN_DIR)/readable.o $(GEN_DIR)/canonical.o \
             $(BUILD_DIR)/situ/situ.o

# The agent protocol's framing (B.2), generated at situ's frame layer,
# which also writes the build and edit headers of the rungs below it.
AGENT_GEN  = $(GEN_DIR)/message.c $(GEN_DIR)/message.h \
             $(GEN_DIR)/message_frame.h $(GEN_DIR)/message_build.h \
             $(GEN_DIR)/message_edit.h
AGENT_OBJS = $(BUILD_DIR)/agent/framing.o $(GEN_DIR)/message.o

# hull.conf, checked against Appendix J by a walk over the reader's forms,
# and a checked machine resolved against an engine's capabilities.
SPEC_OBJS = $(BUILD_DIR)/spec/spec.o
PLAN_OBJS = $(BUILD_DIR)/plan/matrix.o $(BUILD_DIR)/plan/registry.o \
            $(BUILD_DIR)/plan/plan.o $(BUILD_DIR)/plan/names.o

# The engines that ship with the core, as declarations so far, and the
# command line that plans with them. VERSION is the one place the number
# lives; `hull --version` prints it.
ENGINE_OBJS = $(BUILD_DIR)/engine/docker.o $(BUILD_DIR)/engine/qemu.o \
              $(BUILD_DIR)/engine/chroot.o $(BUILD_DIR)/engine/dos.o \
              $(BUILD_DIR)/engine/dosbox.o $(BUILD_DIR)/engine/dosemu.o $(BUILD_DIR)/engine/pc.o \
              $(BUILD_DIR)/engine/hw.o \
              $(BUILD_DIR)/engine/iso.o \
              $(BUILD_DIR)/engine/media.o \
              $(GEN_DIR)/disc.o \
              $(BUILD_DIR)/engine/access.o \
              $(BUILD_DIR)/engine/usage.o $(BUILD_DIR)/engine/sha256.o $(BUILD_DIR)/engine/verity.o \
              $(BUILD_DIR)/engine/stack.o $(BUILD_DIR)/engine/ip6.o $(BUILD_DIR)/engine/idmap.o \
              $(BUILD_DIR)/engine/tree.o $(BUILD_DIR)/engine/user.o $(BUILD_DIR)/engine/hostnet.o \
              $(BUILD_DIR)/engine/hostdev.o $(BUILD_DIR)/engine/rootmode.o
CLI_OBJS    = $(BUILD_DIR)/cli/hull.o $(BUILD_DIR)/cli/runtime.o $(BUILD_DIR)/cli/doctor.o \
              $(BUILD_DIR)/cli/import.o $(BUILD_DIR)/cli/export.o $(BUILD_DIR)/cli/kernel_fetch.o $(BUILD_DIR)/cli/vbox_fetch.o $(BUILD_DIR)/cli/vbox_host.o $(BUILD_DIR)/cli/vagrant.o $(BUILD_DIR)/cli/dial.o \
              $(BUILD_DIR)/cli/sshd_fetch.o
# Section 3's optional store, which only the commands that name it use.
STORE_OBJS  = $(BUILD_DIR)/store/store.o $(BUILD_DIR)/store/unpack.o $(BUILD_DIR)/store/pack.o
# Section 3.5's border: what `hull pull` reads a registry with.
OCI_OBJS    = $(BUILD_DIR)/oci/json.o $(BUILD_DIR)/oci/https.o $(BUILD_DIR)/oci/remote.o \
              $(BUILD_DIR)/oci/pull.o $(BUILD_DIR)/oci/push.o
# The holder's choice, 2026-10-21 (section 3.5): TLS by OpenSSL, layers by zlib;
# and by section 9's rule, packs by libzstd and a fetched kernel's package by liblzma.
PULL_LIBS   = -lssl -lcrypto -lz -lzstd -llzma

# The per-user core, and the frontend protocol it speaks (section 4.10),
# validated by C situ generates from core/frontend.situ.
FRONTEND_GEN = $(GEN_DIR)/frontend.c $(GEN_DIR)/frontend.h
# The agent protocol (Appendix B), validated in both directions by the
# same wire: the host reads the agent's messages, the agent the host's.
PROTOCOL_GEN = $(GEN_DIR)/protocol.c $(GEN_DIR)/protocol.h
# The frames hull at a segment's .1 reads from machines and writes back
# (Appendix D), each validated before a field is read, from core/frame.situ.
# Its checksum codec is derived, situc gen-derived's frame_derived.c.
FRAME_GEN    = $(GEN_DIR)/frame.c $(GEN_DIR)/frame.h $(GEN_DIR)/frame_edit.h $(GEN_DIR)/frame_build.h \
               $(GEN_DIR)/frame_derived.c
# An ISO9660 image's structures, which engine/iso.c builds a disc's data
# track from (section 3.10), from engine/disc.situ.
DISC_GEN     = $(GEN_DIR)/disc.c $(GEN_DIR)/disc.h $(GEN_DIR)/disc_edit.h $(GEN_DIR)/disc_build.h
WIRE_OBJS    = $(BUILD_DIR)/core/wire.o $(GEN_DIR)/frontend.o $(GEN_DIR)/protocol.o \
               $(BUILD_DIR)/agent/framing.o $(GEN_DIR)/message.o
CORE_OBJS    = $(BUILD_DIR)/core/core.o $(BUILD_DIR)/core/segment.o $(GEN_DIR)/frame.o \
               $(GEN_DIR)/frame_derived.o $(WIRE_OBJS)
HULL        = $(BUILD_DIR)/hull

# The guest agent, PID 1 in a qemu machine: static, since the initramfs
# the engine writes holds nothing else, and beside hull, where the engine
# looks for it.
AGENT_BIN_OBJS = $(BUILD_DIR)/agent/agent.o $(WIRE_OBJS) $(BUILD_DIR)/engine/access.o \
                 $(BUILD_DIR)/engine/stack.o $(BUILD_DIR)/engine/ip6.o \
                 $(BUILD_DIR)/engine/tree.o $(BUILD_DIR)/engine/user.o
AGENT_BIN      = $(BUILD_DIR)/hull-agent
# The same agent for an arm64 machine under emu, beside it, where a cross
# compiler is installed (ARM64_CC, below): its sources the native one's,
# built from the objects' names, its generated C the same files.
AGENT_SOURCES  = $(patsubst $(BUILD_DIR)/%.o,%.c,$(patsubst $(BUILD_DIR)/situ/situ.o,$(SITU_DIR)/runtime/c/situ.c,$(patsubst $(GEN_DIR)/%.o,$(GEN_DIR)/%.c,$(AGENT_BIN_OBJS) $(SEXPR_OBJS))))

# hull's own kernel for a vm (Appendix F), beside hull as its agent is,
# where `(kernel hull)` boots it: Linux at a pinned stable version, its
# tarball checked against the sha256 kernel.org signs, tinyconfig with
# kernel/x86_64.config merged, every driver a hull vm needs built in.
# Built by `make kernel` alone, it being a long build and a download.
KERNEL_VERSION = 6.12.107
KERNEL_SHA256  = a5f8c5be3fde2d6d9ca14e9631642cf1f44487143f11059da730dcd5892e307a
KERNEL_TAR     = $(BUILD_DIR)/kernel/linux-$(KERNEL_VERSION).tar.xz
KERNEL_SRC     = $(BUILD_DIR)/kernel/linux-$(KERNEL_VERSION)
KERNEL_BIN     = $(BUILD_DIR)/vmlinuz-hull

# Limine from source (section 3.13), beside hull in limine/, where
# `hull export --bootable` takes it in place of the fetched 11.x UEFI
# loader: 12.x, with its BIOS stages and the tool that installs them, so
# an exported image boots under a BIOS as well. GNU binutils for the
# target tools, the default being LLVM's. Built by `make limine` alone.
LIMINE_VERSION = 12.9.6
LIMINE_SHA256  = 6a4477636e108bcaaa88d7749f43dc3d3ba09a7d548244f3b1e847d27bc1b9a4
LIMINE_TAR     = $(BUILD_DIR)/limine-src/limine-$(LIMINE_VERSION).tar.xz
LIMINE_SRC     = $(BUILD_DIR)/limine-src/limine-$(LIMINE_VERSION)
LIMINE_FILES   = $(BUILD_DIR)/limine/BOOTX64.EFI $(BUILD_DIR)/limine/limine-bios.sys \
                 $(BUILD_DIR)/limine/limine

# The hosts database for section 8.1's names, loaded by glibc into any
# program that looks a name up: nothing of hull's but its own file.
NSS_LIB    = $(BUILD_DIR)/libnss_hull.so.2
# Root mode's helper (project.md section 7), installed setuid root apart
# by install-root and by nothing else. The path hull runs it from is
# hull_engine.h's HULL_ROOT_HELPER_PATH, which this must match.
ROOT_BIN    = $(BUILD_DIR)/hull-root
ROOT_HELPER ?= /usr/local/libexec/hull/hull-root
NSS_LIBDIR ?= /usr/lib/$(shell $(CC) -print-multiarch)
VERSION    := $(shell cat VERSION)

