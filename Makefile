# hull -- the s-expression reader is the first code (sexpr/), generated in
# part by situ from two schemas; the design is project.md. This Makefile
# builds the reader, runs the checks and installs the git hook.

PYTHON    ?= python3
CFLAGS    ?= -Os -g
WARNINGS   = -std=c11 -Wall -Wextra -Wconversion -Wsign-conversion
DEPFLAGS   = -MMD -MP
BUILD_DIR ?= build

# --- situ, vendored ---------------------------------------------------------
#
# A submodule pinned to a commit situ's remote has, called by its path and
# never through PATH: the packaged situc of 2026-08-05 prints the same
# `situc 1.0` as the source tree does, so nothing could tell an old one was
# running.
SITU_DIR  = vendor/situ
SITU_MARK = $(SITU_DIR)/bin/situc
SITUC     = $(PYTHON) $(SITU_MARK)

# What generated code depends on: the whole compiler, not only the script
# that starts it. Moving the pin to a situ whose code generator changed and
# whose bin/situc did not regenerated nothing when only the script was
# named, and the suite then passed against code the old situ had written.
SITU_COMPILER = $(SITU_MARK) $(wildcard $(SITU_DIR)/situc/*.py \
                $(SITU_DIR)/situc/*/*.py $(SITU_DIR)/situc/*/*/*.py)

# Fetched on demand, and only for goals that need it: `style`, `clean`,
# `help` and `hooks` must work in a tree whose submodule was never
# initialised. MAKECMDGOALS is empty for a bare `make`, which does need it.
#
# A no-write mode (-n, -q, -t) never fetches, because a dry run is how
# somebody finds out what a target does BEFORE letting it do anything. git
# is asked with `rev-parse` rather than by looking for a `.git` directory,
# which is a file in a worktree or a submodule checkout. Shape taken from
# raidcfgd's aea68a4.
MAKE_SHORT_FLAGS := $(filter-out -%,$(firstword $(MAKEFLAGS)))
NO_WRITE := $(findstring n,$(MAKE_SHORT_FLAGS))$(findstring q,$(MAKE_SHORT_FLAGS))$(findstring t,$(MAKE_SHORT_FLAGS))

SUBMODULE_FETCH_SH = \
	if [ -n "$(NO_WRITE)" ]; then \
		echo "make: $(1)/ is empty, and -n, -q and -t do not fetch it," >&2; \
		echo "make: so this describes a build that cannot run yet." >&2; \
	elif ! command -v git >/dev/null 2>&1; then \
		echo "make: $(1)/ is empty and git is not installed." >&2; \
	elif [ -z "$$(git rev-parse --git-common-dir 2>/dev/null)" ]; then \
		echo "make: $(1)/ is empty and this is not a git checkout," >&2; \
		echo "make: so the vendored $(2) cannot be fetched." >&2; \
	else \
		echo "make: fetching the $(1) submodule" >&2; \
		git submodule update --init $(1) >&2; \
	fi

SITU_FREE_GOALS = help style style-source style-docs hooks clean
ifneq ($(filter-out $(SITU_FREE_GOALS),$(or $(MAKECMDGOALS),all)),)
ifeq ($(wildcard $(SITU_MARK)),)
SITU_FETCH := $(shell $(call SUBMODULE_FETCH_SH,$(SITU_DIR),situ))
# Fail rather than build less: the reader is generated by situ, and there
# is no build of it without situ.
ifeq ($(NO_WRITE),)
ifeq ($(wildcard $(SITU_MARK)),)
$(error $(SITU_DIR) could not be fetched, and the reader cannot be generated without it)
endif
endif
endif
endif

# --- the reader -------------------------------------------------------------

GEN_DIR     = $(BUILD_DIR)/gen
SCHEMAS     = sexpr/readable.situ sexpr/canonical.situ
GEN_SOURCES = $(GEN_DIR)/readable.c $(GEN_DIR)/canonical.c
GEN_HEADERS = $(GEN_DIR)/readable.h $(GEN_DIR)/canonical.h \
              $(GEN_DIR)/canonical_build.h $(GEN_DIR)/canonical_edit.h

SEXPR_OBJS = $(BUILD_DIR)/sexpr/sexpr.o $(BUILD_DIR)/sexpr/writer.o \
             $(BUILD_DIR)/sexpr/convert.o \
             $(GEN_DIR)/readable.o $(GEN_DIR)/canonical.o \
             $(BUILD_DIR)/situ/situ.o

# The agent protocol's framing (B.2), generated at situ's frame layer,
# which also writes the build and edit headers of the rungs below it.
AGENT_GEN  = $(GEN_DIR)/message.c $(GEN_DIR)/message.h \
             $(GEN_DIR)/message_frame.h $(GEN_DIR)/message_build.h \
             $(GEN_DIR)/message_edit.h
AGENT_OBJS = $(BUILD_DIR)/agent/framing.o $(GEN_DIR)/message.o

# hull.conf, checked against Appendix J by a walk over the reader's forms,
# and a checked machine resolved against an engine's capabilities.
SPEC_OBJS = $(BUILD_DIR)/spec/spec.o
PLAN_OBJS = $(BUILD_DIR)/plan/matrix.o $(BUILD_DIR)/plan/registry.o \
            $(BUILD_DIR)/plan/plan.o

# The engines that ship with the core, as declarations so far, and the
# command line that plans with them. VERSION is the one place the number
# lives; `hull --version` prints it.
ENGINE_OBJS = $(BUILD_DIR)/engine/docker.o $(BUILD_DIR)/engine/qemu.o \
              $(BUILD_DIR)/engine/chroot.o $(BUILD_DIR)/engine/access.o
CLI_OBJS    = $(BUILD_DIR)/cli/hull.o

# The per-user core, and the frontend protocol it speaks (section 4.10),
# validated by C situ generates from core/frontend.situ.
FRONTEND_GEN = $(GEN_DIR)/frontend.c $(GEN_DIR)/frontend.h
CORE_OBJS    = $(BUILD_DIR)/core/core.o $(BUILD_DIR)/core/wire.o $(GEN_DIR)/frontend.o \
               $(BUILD_DIR)/agent/framing.o $(GEN_DIR)/message.o
HULL        = $(BUILD_DIR)/hull
VERSION    := $(shell cat VERSION)

TEST_SEXPR_OBJS   = $(BUILD_DIR)/test/sexpr_test.o
TEST_FRAMING_OBJS = $(BUILD_DIR)/test/framing_test.o
# What test/cli_test.sh writes, so that clean can name it.
CLI_TEST_FILES = $(addprefix $(BUILD_DIR)/test/cli/, ref.conf dir.conf inotify.conf \
                 foreign.conf machines.conf build.conf bad.conf example.conf run.conf \
                 writable.conf readonly.conf die.conf wait.conf ports.conf noargs.conf nope.conf \
                 qemu.conf pair.conf rootfs/written vol.conf volro.conf vollink.conf \
                 volmissing.conf volhost.conf pid.conf keep.conf gone.conf execd.conf attach.out \
                 data/in data/out rootfs/mnt-link) \
                 $(addprefix $(BUILD_DIR)/test/run/hull/, core.log core.lock)

# What test/docker_test.sh writes.
DOCKER_TEST_FILES = $(addprefix $(BUILD_DIR)/test/docker/, run.conf vol.conf volro.conf \
                    rootro.conf nocap.conf cap.conf die.conf wait.conf port.conf noimage.conf \
                    nocmd.conf execd.conf data/in data/out)

# The reference engine's test rootfs holds one static program.
PROBE = $(BUILD_DIR)/test/cli/rootfs/probe

TEST_SPEC_OBJS    = $(BUILD_DIR)/test/spec_test.o
TEST_MATRIX_OBJS  = $(BUILD_DIR)/test/matrix_test.o
TEST_REGISTRY_OBJS = $(BUILD_DIR)/test/registry_test.o
TEST_PLAN_OBJS    = $(BUILD_DIR)/test/plan_test.o
TEST_WIRE_OBJS    = $(BUILD_DIR)/test/wire_test.o
TEST_OBJS = $(TEST_SEXPR_OBJS) $(TEST_FRAMING_OBJS) $(TEST_SPEC_OBJS) $(TEST_MATRIX_OBJS) \
            $(TEST_REGISTRY_OBJS) $(TEST_PLAN_OBJS) $(TEST_WIRE_OBJS)
TEST_BINS = $(BUILD_DIR)/test/sexpr_test $(BUILD_DIR)/test/framing_test \
            $(BUILD_DIR)/test/spec_test $(BUILD_DIR)/test/matrix_test \
            $(BUILD_DIR)/test/registry_test $(BUILD_DIR)/test/plan_test \
            $(BUILD_DIR)/test/wire_test

CPPFLAGS += -I. -Isexpr -Iagent -Ispec -Iplan -Iengine -Icore -I$(GEN_DIR) -I$(SITU_DIR)/runtime/c

.PHONY: all check check-docker test vectors style style-source style-docs contract hooks clean help

all: $(SEXPR_OBJS) $(AGENT_OBJS) $(SPEC_OBJS) $(PLAN_OBJS) $(HULL)

help:
	@echo 'Targets:'
	@echo '  all       build the libraries and build/hull (the default)'
	@echo '  check     style, the situ contracts, then the tests'
	@echo '  check-docker  hull run on the docker adapter, against the local daemon'
	@echo '  test      build and run the reader tests, the vectors, then the gate'"'"'s'
	@echo '  vectors   the described schemas against bytes they must accept and refuse'
	@echo '  style     the indentation and whitespace gate'
	@echo '  contract  the schemas'"'"' capability maps against the committed ones'
	@echo '  hooks     install the commit-msg hook from tool/hooks/'
	@echo '  clean     remove what the build made, naming each file'

# Each schema generates a header and a source in one situc run, so both are
# one grouped target and a parallel build runs it once.
$(GEN_DIR)/readable.c $(GEN_DIR)/readable.h &: sexpr/readable.situ $(SITU_COMPILER)
	@mkdir -p '$(GEN_DIR)'
	$(SITUC) build --target c --prefix hull_sexpr_r --out '$(GEN_DIR)' sexpr/readable.situ

# Canonical form is generated at the edit layer, whose build header is
# what the writer appends with. The edit header beside it is not used:
# situ finding 10, it does not compile for a `decimal` member.
$(GEN_DIR)/canonical.c $(GEN_DIR)/canonical.h $(GEN_DIR)/canonical_build.h \
$(GEN_DIR)/canonical_edit.h &: sexpr/canonical.situ $(SITU_COMPILER)
	@mkdir -p '$(GEN_DIR)'
	$(SITUC) build --target c --layer edit --prefix hull_sexpr_c --out '$(GEN_DIR)' sexpr/canonical.situ

$(FRONTEND_GEN) &: core/frontend.situ sexpr/canonical.situ $(SITU_COMPILER)
	@mkdir -p '$(GEN_DIR)'
	$(SITUC) build --target c --prefix hull_frontend --out '$(GEN_DIR)' core/frontend.situ

$(AGENT_GEN) &: agent/message.situ $(SITU_COMPILER)
	@mkdir -p '$(GEN_DIR)'
	$(SITUC) build --target c --layer frame --prefix hull_agent --out '$(GEN_DIR)' agent/message.situ

# The generated headers are order-only for hand-written objects: they must
# exist before the first compile, and after that the .d files say when a
# change to one should rebuild what includes it.
$(BUILD_DIR)/sexpr/%.o: sexpr/%.c | $(GEN_HEADERS)
	@mkdir -p '$(@D)'
	$(CC) $(CPPFLAGS) $(CFLAGS) $(WARNINGS) $(DEPFLAGS) -c -o $@ $<

$(BUILD_DIR)/agent/%.o: agent/%.c | $(GEN_HEADERS) $(AGENT_GEN)
	@mkdir -p '$(@D)'
	$(CC) $(CPPFLAGS) $(CFLAGS) $(WARNINGS) $(DEPFLAGS) -c -o $@ $<

$(BUILD_DIR)/spec/%.o: spec/%.c | $(GEN_HEADERS)
	@mkdir -p '$(@D)'
	$(CC) $(CPPFLAGS) $(CFLAGS) $(WARNINGS) $(DEPFLAGS) -c -o $@ $<

$(BUILD_DIR)/plan/%.o: plan/%.c | $(GEN_HEADERS)
	@mkdir -p '$(@D)'
	$(CC) $(CPPFLAGS) $(CFLAGS) $(WARNINGS) $(DEPFLAGS) -c -o $@ $<

$(BUILD_DIR)/engine/%.o: engine/%.c
	@mkdir -p '$(@D)'
	$(CC) $(CPPFLAGS) $(CFLAGS) $(WARNINGS) $(DEPFLAGS) -c -o $@ $<

$(BUILD_DIR)/core/%.o: core/%.c VERSION | $(GEN_HEADERS) $(AGENT_GEN) $(FRONTEND_GEN)
	@mkdir -p '$(@D)'
	$(CC) $(CPPFLAGS) -DHULL_VERSION='"$(VERSION)"' $(CFLAGS) $(WARNINGS) $(DEPFLAGS) -c -o $@ $<

# The version is a prerequisite, so a new number rebuilds what prints it.
$(BUILD_DIR)/cli/%.o: cli/%.c VERSION | $(GEN_HEADERS) $(AGENT_GEN) $(FRONTEND_GEN)
	@mkdir -p '$(@D)'
	$(CC) $(CPPFLAGS) -DHULL_VERSION='"$(VERSION)"' $(CFLAGS) $(WARNINGS) $(DEPFLAGS) -c -o $@ $<

$(PROBE): test/probe.c
	@mkdir -p '$(@D)'
	$(CC) -static $(CFLAGS) -o $@ $<

$(HULL): $(CLI_OBJS) $(CORE_OBJS) $(ENGINE_OBJS) $(PLAN_OBJS) $(SPEC_OBJS) $(SEXPR_OBJS)
	$(CC) $(CFLAGS) -pthread -o $@ $^

$(GEN_DIR)/%.o: $(GEN_DIR)/%.c
	$(CC) $(CPPFLAGS) $(CFLAGS) $(WARNINGS) $(DEPFLAGS) -c -o $@ $<

# The generated frontend protocol compiles only behind a forward
# declaration (situ finding 18): core/frontend_view.h comes first, and the
# header's own guard makes the file's include of it a no-op. This rule
# goes with that file.
$(GEN_DIR)/frontend.o: $(GEN_DIR)/frontend.c core/frontend_view.h
	$(CC) $(CPPFLAGS) -include core/frontend_view.h $(CFLAGS) $(WARNINGS) $(DEPFLAGS) \
	      -c -o $@ $(filter %.c,$^)

$(BUILD_DIR)/situ/situ.o: $(SITU_DIR)/runtime/c/situ.c
	@mkdir -p '$(@D)'
	$(CC) $(CPPFLAGS) $(CFLAGS) $(WARNINGS) $(DEPFLAGS) -c -o $@ $<

$(BUILD_DIR)/test/%.o: test/%.c | $(GEN_HEADERS) $(AGENT_GEN)
	@mkdir -p '$(@D)'
	$(CC) $(CPPFLAGS) $(CFLAGS) $(WARNINGS) $(DEPFLAGS) -c -o $@ $<

$(BUILD_DIR)/test/sexpr_test: $(TEST_SEXPR_OBJS) $(SEXPR_OBJS)
	$(CC) $(CFLAGS) -o $@ $^

$(BUILD_DIR)/test/framing_test: $(TEST_FRAMING_OBJS) $(AGENT_OBJS) $(SEXPR_OBJS)
	$(CC) $(CFLAGS) -o $@ $^

$(BUILD_DIR)/test/spec_test: $(TEST_SPEC_OBJS) $(SPEC_OBJS) $(SEXPR_OBJS)
	$(CC) $(CFLAGS) -o $@ $^

$(BUILD_DIR)/test/matrix_test: $(TEST_MATRIX_OBJS) $(PLAN_OBJS) $(SPEC_OBJS) $(SEXPR_OBJS)
	$(CC) $(CFLAGS) -o $@ $^

$(BUILD_DIR)/test/registry_test: $(TEST_REGISTRY_OBJS) $(PLAN_OBJS) $(SPEC_OBJS) $(SEXPR_OBJS)
	$(CC) $(CFLAGS) -o $@ $^

$(BUILD_DIR)/test/plan_test: $(TEST_PLAN_OBJS) $(PLAN_OBJS) $(SPEC_OBJS) $(SEXPR_OBJS)
	$(CC) $(CFLAGS) -o $@ $^

$(BUILD_DIR)/test/wire_test: $(TEST_WIRE_OBJS) $(BUILD_DIR)/core/wire.o $(GEN_DIR)/frontend.o \
                             $(BUILD_DIR)/agent/framing.o $(GEN_DIR)/message.o $(SEXPR_OBJS)
	$(CC) $(CFLAGS) -o $@ $^

-include $(SEXPR_OBJS:.o=.d) $(AGENT_OBJS:.o=.d) $(SPEC_OBJS:.o=.d) $(PLAN_OBJS:.o=.d) \
         $(ENGINE_OBJS:.o=.d) $(CLI_OBJS:.o=.d) $(CORE_OBJS:.o=.d) $(TEST_OBJS:.o=.d)

# --- checks -----------------------------------------------------------------

# Appendices A and B and the core protocol (project.md section 4.10) as
# situ describes them: schemas nothing is generated from yet, held to
# their committed maps and to vectors of real bytes.
DESCRIBED = manifest/manifest agent/protocol core/frontend

check: style contract test

# The reader's tests -- the spec's against every ```scheme example in
# project.md as well -- then the gate's own suite, which travels with the
# gate. Tests are built here and only here: a plain `make` does not.
test: $(TEST_BINS) $(HULL) $(PROBE) vectors
	$(BUILD_DIR)/test/sexpr_test
	$(BUILD_DIR)/test/framing_test
	$(BUILD_DIR)/test/spec_test project.md
	$(BUILD_DIR)/test/matrix_test
	$(BUILD_DIR)/test/registry_test
	$(BUILD_DIR)/test/plan_test
	$(BUILD_DIR)/test/wire_test
	BUILD_DIR='$(BUILD_DIR)' sh test/cli_test.sh '$(HULL)'
	$(PYTHON) tool/test_style_gate.py

# Each schema accepts every vector in its .vectors and refuses every one in
# its .refused.vectors. Both are counted against the file, since situc
# reports success over a file holding none, and it says nothing about a
# vector it refused for a reason other than the one meant: the comments in
# the files say what each is for.
vectors: $(SITU_MARK)
	@for d in $(DESCRIBED); do \
		n=$$(grep -c '^[a-z]' $$d.vectors); \
		out=$$($(SITUC) verify $$d.situ $$d.vectors 2>&1); \
		echo "$$out" | grep -q "^situc: $$n vectors conform to $$d.situ" || \
			{ echo "$$out"; echo "vectors: $$d.vectors: not all $$n accepted" >&2; exit 1; }; \
		echo "vectors: $$d.situ accepts all $$n in $$d.vectors"; \
		n=$$(grep -c '^[a-z]' $$d.refused.vectors); \
		out=$$($(SITUC) verify $$d.situ $$d.refused.vectors 2>&1); \
		echo "$$out" | grep -qx "situc: $$n of $$n vectors do not conform to $$d.situ" || \
			{ echo "$$out"; echo "vectors: $$d.refused.vectors: not all $$n refused" >&2; exit 1; }; \
		echo "vectors: $$d.situ refuses all $$n in $$d.refused.vectors"; \
	done

# The docker adapter against a real daemon. Not in `check`, which needs
# none: this one starts containers on the daemon the account can reach,
# from alpine:latest, which it does not pull.
check-docker: $(HULL)
	BUILD_DIR='$(BUILD_DIR)' sh test/docker_test.sh '$(HULL)'

# The indentation and whitespace gate, shared verbatim with the sibling
# projects; `docs` additionally holds project.md to the tree it describes.
style: style-source style-docs

style-source:
	$(PYTHON) tool/style_gate.py check

style-docs:
	$(PYTHON) tool/style_gate.py docs

# What each schema costs -- every field's capability vector -- against the
# committed map beside it. A situ update that changes how a form is framed
# or reached fails here, before it reaches the reader.
contract: $(SITU_MARK)
	$(SITUC) map --check sexpr/readable.situ
	$(SITUC) map --check sexpr/canonical.situ
	$(SITUC) map --check agent/message.situ
	$(SITUC) map --check manifest/manifest.situ
	$(SITUC) map --check agent/protocol.situ
	$(SITUC) map --check core/frontend.situ

hooks:
	@if ! command -v git >/dev/null 2>&1; then \
		echo "hooks: git is not installed, so there is nowhere to install to." >&2; \
		exit 1; \
	fi; \
	dir=$$(git rev-parse --git-common-dir 2>/dev/null); \
	if [ -z "$$dir" ]; then \
		echo "hooks: not a git repository, so there is nowhere to install to." >&2; \
		exit 1; \
	fi; \
	mkdir -p "$$dir/hooks"; \
	install -m 0755 tool/hooks/commit-msg "$$dir/hooks/commit-msg"; \
	echo "hooks: commit-msg installed from tool/hooks/ into $$dir/hooks/"

# Named files only, each printed as it goes. The directories stay.
clean:
	@rm -fv $(TEST_BINS) $(TEST_OBJS) $(TEST_OBJS:.o=.d) \
	        $(SEXPR_OBJS) $(SEXPR_OBJS:.o=.d) $(GEN_SOURCES) $(GEN_HEADERS) \
	        $(AGENT_OBJS) $(AGENT_OBJS:.o=.d) $(AGENT_GEN) \
	        $(SPEC_OBJS) $(SPEC_OBJS:.o=.d) $(PLAN_OBJS) $(PLAN_OBJS:.o=.d) \
	        $(ENGINE_OBJS) $(ENGINE_OBJS:.o=.d) $(CLI_OBJS) $(CLI_OBJS:.o=.d) $(HULL) \
	        $(CORE_OBJS) $(CORE_OBJS:.o=.d) $(FRONTEND_GEN) \
	        $(CLI_TEST_FILES) $(PROBE) $(DOCKER_TEST_FILES)
