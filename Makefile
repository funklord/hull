# Each schema generates a header and a source in one situc run, so both are
# one grouped target and a parallel build runs it once.
$(GEN_DIR)/readable.c $(GEN_DIR)/readable.h &: sexpr/readable.situ $(SITU_COMPILER)
	@mkdir -p '$(GEN_DIR)'
	$(SITUC) build --target c --prefix hull_sexpr_r --out '$(GEN_DIR)' sexpr/readable.situ

# Canonical form is generated at the edit layer, whose build header is
# what the writer appends with. The edit header beside it is not used:
# situ finding 10, it does not compile for a `decimal` member.
$(GEN_DIR)/canonical.c $(GEN_DIR)/canonical.h $(GEN_DIR)/canonical_build.h \
$(GEN_DIR)/canonical_edit.h &: sexpr/canonical.situ $(SITU_COMPILER)
	@mkdir -p '$(GEN_DIR)'
	$(SITUC) build --target c --layer edit --prefix hull_sexpr_c --out '$(GEN_DIR)' sexpr/canonical.situ

$(FRONTEND_GEN) &: core/frontend.situ sexpr/canonical.situ $(SITU_COMPILER)
	@mkdir -p '$(GEN_DIR)'
	$(SITUC) build --target c --prefix hull_frontend --out '$(GEN_DIR)' core/frontend.situ

$(PROTOCOL_GEN) &: agent/protocol.situ sexpr/canonical.situ $(SITU_COMPILER)
	@mkdir -p '$(GEN_DIR)'
	$(SITUC) build --target c --prefix hull_protocol --out '$(GEN_DIR)' agent/protocol.situ

$(FRAME_GEN) &: core/frame.situ $(SITU_COMPILER)
	@mkdir -p '$(GEN_DIR)'
	$(SITUC) build --target c --layer edit --prefix hull_frame --out '$(GEN_DIR)' core/frame.situ
	$(SITUC) gen-derived --target c --prefix hull_frame --out '$(GEN_DIR)' core/frame.situ

$(DISC_GEN) &: engine/disc.situ $(SITU_COMPILER)
	@mkdir -p '$(GEN_DIR)'
	$(SITUC) build --target c --layer edit --prefix hull_disc --out '$(GEN_DIR)' engine/disc.situ

$(AGENT_GEN) &: agent/message.situ $(SITU_COMPILER)
	@mkdir -p '$(GEN_DIR)'
	$(SITUC) build --target c --layer frame --prefix hull_agent --out '$(GEN_DIR)' agent/message.situ

# The generated headers are order-only for hand-written objects: they must
# exist before the first compile, and after that the .d files say when a
# change to one should rebuild what includes it.
$(BUILD_DIR)/sexpr/%.o: sexpr/%.c | $(GEN_HEADERS)
	@mkdir -p '$(@D)'
	$(CC) $(CPPFLAGS) $(CFLAGS) $(WARNINGS) $(DEPFLAGS) -c -o $@ $<

$(BUILD_DIR)/agent/%.o: agent/%.c | $(GEN_HEADERS) $(AGENT_GEN) $(FRONTEND_GEN) $(PROTOCOL_GEN)
	@mkdir -p '$(@D)'
	$(CC) $(CPPFLAGS) $(CFLAGS) $(WARNINGS) $(DEPFLAGS) -c -o $@ $<

$(BUILD_DIR)/spec/%.o: spec/%.c | $(GEN_HEADERS)
	@mkdir -p '$(@D)'
	$(CC) $(CPPFLAGS) $(CFLAGS) $(WARNINGS) $(DEPFLAGS) -c -o $@ $<

$(BUILD_DIR)/plan/%.o: plan/%.c | $(GEN_HEADERS)
	@mkdir -p '$(@D)'
	$(CC) $(CPPFLAGS) $(CFLAGS) $(WARNINGS) $(DEPFLAGS) -c -o $@ $<

$(BUILD_DIR)/engine/%.o: engine/%.c | $(GEN_HEADERS) $(AGENT_GEN) $(DISC_GEN)
	@mkdir -p '$(@D)'
	$(CC) $(CPPFLAGS) $(CFLAGS) $(WARNINGS) $(DEPFLAGS) -c -o $@ $<

$(BUILD_DIR)/store/%.o: store/%.c | $(GEN_HEADERS)
	@mkdir -p '$(@D)'
	$(CC) $(CPPFLAGS) $(CFLAGS) $(WARNINGS) $(DEPFLAGS) -c -o $@ $<

$(BUILD_DIR)/oci/%.o: oci/%.c
	@mkdir -p '$(@D)'
	$(CC) $(CPPFLAGS) $(CFLAGS) $(WARNINGS) $(DEPFLAGS) -c -o $@ $<

$(BUILD_DIR)/core/%.o: core/%.c VERSION | $(GEN_HEADERS) $(AGENT_GEN) $(FRONTEND_GEN) \
                                          $(PROTOCOL_GEN) $(FRAME_GEN)
	@mkdir -p '$(@D)'
	$(CC) $(CPPFLAGS) -DHULL_VERSION='"$(VERSION)"' $(CFLAGS) $(WARNINGS) $(DEPFLAGS) -c -o $@ $<

# The commit hull is built from, for --version, so that a result can name
# the hull it rested on without guessing from where the binary sits. The
# rule runs every time and replaces the file only when what it says
# changes: a new commit rebuilds what prints it, and nothing else, where
# a -D flag alone would leave an object naming an old one. -dirty where the
# tree had changes of anybody's, as it was built from those.
$(GEN_DIR)/commit.h: FORCE
	@mkdir -p '$(@D)'
	@commit=$$(git describe --always --dirty --abbrev=12 2>/dev/null || echo unknown); \
	printf '#define HULL_COMMIT "%s"\n' "$$commit" > '$@.new'; \
	if cmp -s '$@.new' '$@'; then rm -f '$@.new'; else mv '$@.new' '$@'; fi

FORCE:

$(BUILD_DIR)/cli/hull.o: $(GEN_DIR)/commit.h
# The core reports this commit in its hello, so a newer frontend sees a
# core left from an older build; it must rebuild when the commit changes.
$(BUILD_DIR)/core/core.o: $(GEN_DIR)/commit.h
# The agent says it too, so a vm's result can name the agent it ran under.
$(BUILD_DIR)/agent/agent.o: $(GEN_DIR)/commit.h

# The version is a prerequisite, so a new number rebuilds what prints it.
$(BUILD_DIR)/cli/%.o: cli/%.c VERSION | $(GEN_HEADERS) $(AGENT_GEN) $(FRONTEND_GEN)
	@mkdir -p '$(@D)'
	$(CC) $(CPPFLAGS) -DHULL_VERSION='"$(VERSION)"' $(CFLAGS) $(WARNINGS) $(DEPFLAGS) -c -o $@ $<

$(PROBE): test/probe.c
	@mkdir -p '$(@D)'
	$(CC) -static $(CFLAGS) -o $@ $<

$(BUILD_DIR)/test/arm64/rootfs/probe: test/probe.c
	@mkdir -p '$(@D)/proc' '$(@D)/dev'
	$(ARM64_CC) -static $(CFLAGS) -o $@ $<

$(BUILD_DIR)/test/riscv64/rootfs/probe: test/probe.c
	@mkdir -p '$(@D)/proc' '$(@D)/dev'
	$(RISCV64_CC) -static $(CFLAGS) -o $@ $<

$(BUILD_DIR)/test/s390x/rootfs/probe: test/probe.c
	@mkdir -p '$(@D)/proc' '$(@D)/dev'
	$(S390X_CC) -static $(CFLAGS) -o $@ $<

$(HULL): $(CLI_OBJS) $(CORE_OBJS) $(ENGINE_OBJS) $(STORE_OBJS) $(OCI_OBJS) $(PLAN_OBJS) \
         $(SPEC_OBJS) $(SEXPR_OBJS)
	$(CC) $(CFLAGS) -pthread -o $@ $^ $(PULL_LIBS)

$(AGENT_BIN): $(AGENT_BIN_OBJS) $(SEXPR_OBJS)
	$(CC) -static $(CFLAGS) -o $@ $^

kernel: $(KERNEL_BIN) $(KERNEL_ELF) $(KERNEL_MODULES)/modules.dep $(KERNEL_ARM64)

$(KERNEL_TAR):
	@mkdir -p '$(@D)'
	curl -sSfL -o '$@.part' 'https://cdn.kernel.org/pub/linux/kernel/v6.x/linux-$(KERNEL_VERSION).tar.xz'
	echo '$(KERNEL_SHA256)  $@.part' | sha256sum -c --quiet
	mv '$@.part' '$@'

# The source extracted once; a fragment option that did not take, which
# merge_config.sh only warns of, stops the build.
$(KERNEL_BIN): $(KERNEL_TAR) kernel/common.config kernel/x86_64.config
	test -d '$(KERNEL_SRC)' || tar -C '$(BUILD_DIR)/kernel' -xf '$(KERNEL_TAR)'
	$(MAKE) -C '$(KERNEL_SRC)' tinyconfig > /dev/null
	cd '$(KERNEL_SRC)' && scripts/kconfig/merge_config.sh -m .config '$(abspath kernel/common.config)' \
		'$(abspath kernel/x86_64.config)' > /dev/null
	$(MAKE) -C '$(KERNEL_SRC)' olddefconfig > /dev/null
	@for option in $$(grep -h '^CONFIG_' kernel/common.config kernel/x86_64.config); do \
		grep -qx "$$option" '$(KERNEL_SRC)/.config' || { echo "kernel: $$option did not take" >&2; exit 1; }; \
	done
	$(MAKE) -C '$(KERNEL_SRC)' $(KERNEL_STAMP) bzImage
	cp '$(KERNEL_SRC)/arch/x86/boot/bzImage' '$@'

# The same kernel as an ELF, which qemu enters directly (section 5.2).
$(KERNEL_ELF): $(KERNEL_BIN)
	strip -o '$@' '$(KERNEL_SRC)/vmlinux'

# Stripped, and indexed by depmod; the kernel's install clears an earlier
# set's kernel/ first, so no module of it stays behind.
$(KERNEL_MODULES)/modules.dep: $(KERNEL_BIN)
	$(MAKE) -C '$(KERNEL_SRC)' $(KERNEL_STAMP) modules
	$(MAKE) -C '$(KERNEL_SRC)' INSTALL_MOD_PATH='$(abspath $(BUILD_DIR))/modules-hull' \
		INSTALL_MOD_STRIP=1 modules_install > /dev/null
	touch '$@'

# arm64's, the same steps cross-compiled, booted by qemu's virt as the
# gzipped Image it unpacks itself.
$(KERNEL_A64_BIN): $(KERNEL_TAR) kernel/common.config kernel/arm64.config
	@mkdir -p '$(BUILD_DIR)/kernel-arm64'
	test -d '$(KERNEL_A64_SRC)' || tar -C '$(BUILD_DIR)/kernel-arm64' -xf '$(KERNEL_TAR)'
	$(MAKE) -C '$(KERNEL_A64_SRC)' $(KERNEL_A64) tinyconfig > /dev/null
	cd '$(KERNEL_A64_SRC)' && $(KERNEL_A64) scripts/kconfig/merge_config.sh -m .config \
		'$(abspath kernel/common.config)' '$(abspath kernel/arm64.config)' > /dev/null
	$(MAKE) -C '$(KERNEL_A64_SRC)' $(KERNEL_A64) olddefconfig > /dev/null
	@for option in $$(grep -h '^CONFIG_' kernel/common.config kernel/arm64.config); do \
		grep -qx "$$option" '$(KERNEL_A64_SRC)/.config' || { echo "kernel: arm64: $$option did not take" >&2; exit 1; }; \
	done
	$(MAKE) -C '$(KERNEL_A64_SRC)' $(KERNEL_A64) $(KERNEL_STAMP) Image.gz
	cp '$(KERNEL_A64_SRC)/arch/arm64/boot/Image.gz' '$@'

$(KERNEL_A64_MOD)/modules.dep: $(KERNEL_A64_BIN)
	$(MAKE) -C '$(KERNEL_A64_SRC)' $(KERNEL_A64) $(KERNEL_STAMP) modules
	$(MAKE) -C '$(KERNEL_A64_SRC)' $(KERNEL_A64) INSTALL_MOD_PATH='$(abspath $(BUILD_DIR))/modules-hull-arm64' \
		INSTALL_MOD_STRIP=1 modules_install > /dev/null
	touch '$@'

limine: $(LIMINE_FILES)

$(LIMINE_TAR):
	@mkdir -p '$(@D)'
	curl -sSfL -o '$@.part' 'https://github.com/Limine-Bootloader/Limine/releases/download/v$(LIMINE_VERSION)/limine-$(LIMINE_VERSION).tar.xz'
	echo '$(LIMINE_SHA256)  $@.part' | sha256sum -c --quiet
	mv '$@.part' '$@'

$(LIMINE_SRC)/bin/limine: $(LIMINE_TAR)
	test -d '$(LIMINE_SRC)' || tar -C '$(BUILD_DIR)/limine-src' -xf '$(LIMINE_TAR)'
	cd '$(LIMINE_SRC)' && ./configure --enable-bios --enable-uefi-x86-64 \
		CC_FOR_TARGET=gcc LD_FOR_TARGET=ld OBJCOPY_FOR_TARGET=objcopy \
		OBJDUMP_FOR_TARGET=objdump READELF_FOR_TARGET=readelf > /dev/null
	$(MAKE) -C '$(LIMINE_SRC)'

$(LIMINE_FILES): $(LIMINE_SRC)/bin/limine
	@mkdir -p '$(@D)'
	cp '$(LIMINE_SRC)/bin/$(@F)' '$@'

