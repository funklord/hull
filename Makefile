# The unit tests, and the store and pull suites, built and run with
# AddressSanitizer and UndefinedBehaviorSanitizer, in a build directory
# of their own: a fault that a green run hides -- a NULL handed to qsort,
# a shift by 32 -- stops the run there. First run 2026-11-01, which found
# six. Not in `check`, being a second build. The probe is static, which
# the sanitizers cannot be, so the suites get this build's own.
SANITIZE_FLAGS = -O1 -g -fsanitize=address,undefined -fno-omit-frame-pointer \
                 -fno-sanitize-recover=undefined
check-sanitize: $(PROBE)
	$(MAKE) BUILD_DIR='$(BUILD_DIR)/sanitize' CFLAGS='$(SANITIZE_FLAGS)' \
		SANITIZE_PROBE='$(abspath $(PROBE))' sanitize-run

sanitize-run: $(filter-out $(BUILD_DIR)/test/tree_tar,$(TEST_BINS)) $(HULL)
	ASAN_OPTIONS=detect_leaks=1 $(BUILD_DIR)/test/sexpr_test
	ASAN_OPTIONS=detect_leaks=1 $(BUILD_DIR)/test/framing_test
	ASAN_OPTIONS=detect_leaks=1 $(BUILD_DIR)/test/spec_test project.md
	ASAN_OPTIONS=detect_leaks=1 $(BUILD_DIR)/test/matrix_test
	ASAN_OPTIONS=detect_leaks=1 $(BUILD_DIR)/test/registry_test
	ASAN_OPTIONS=detect_leaks=1 $(BUILD_DIR)/test/plan_test
	ASAN_OPTIONS=detect_leaks=1 $(BUILD_DIR)/test/wire_test
	ASAN_OPTIONS=detect_leaks=1 $(BUILD_DIR)/test/sha256_test
	ASAN_OPTIONS=detect_leaks=1 $(BUILD_DIR)/test/verity_test
	ASAN_OPTIONS=detect_leaks=1 $(BUILD_DIR)/test/idmap_test
	ASAN_OPTIONS=detect_leaks=1 $(BUILD_DIR)/test/json_test
	ASAN_OPTIONS=detect_leaks=1 BUILD_DIR='$(BUILD_DIR)' $(BUILD_DIR)/test/runtime_test
	ASAN_OPTIONS=detect_leaks=1 $(BUILD_DIR)/test/segment_test
	ASAN_OPTIONS=detect_leaks=1 BUILD_DIR='$(BUILD_DIR)' $(BUILD_DIR)/test/hostdev_test
	ASAN_OPTIONS=detect_leaks=1 BUILD_DIR='$(BUILD_DIR)' $(BUILD_DIR)/test/iso_test
	ASAN_OPTIONS=detect_leaks=0 BUILD_DIR='$(BUILD_DIR)' sh test/store_test.sh '$(HULL)' '$(SITU_MARK)'
	ASAN_OPTIONS=detect_leaks=0 BUILD_DIR='$(BUILD_DIR)' sh test/media_test.sh '$(HULL)' \
		'$(SANITIZE_PROBE)'
	ASAN_OPTIONS=detect_leaks=0 BUILD_DIR='$(BUILD_DIR)' sh test/pull_test.sh '$(HULL)' \
		'$(SANITIZE_PROBE)' '$(SITU_MARK)'
	ASAN_OPTIONS=detect_leaks=0 BUILD_DIR='$(BUILD_DIR)' sh test/broker_test.sh '$(HULL)' '$(SANITIZE_PROBE)'

# The readers of what a registry sends -- oci/json.c, and store/unpack.c,
# which applies a layer -- under libFuzzer with ASan and UBSan, from
# corpora test/fuzz/seeds.py writes, each for FUZZ_TIME seconds; a crash,
# a leak, or a path made outside the unpacked tree stops it. Needs clang
# with libFuzzer, which the build does not, so it is a target of its own.
# First run 2026-11-01: seven million JSON inputs clean, and a header the
# layer cut short leaking its buffer in the unpacker, fixed.
FUZZ_CC   ?= clang
FUZZ_TIME ?= 60
FUZZ_FLAGS = -g -O1 -fsanitize=fuzzer,address,undefined -fno-sanitize-recover=undefined
FUZZ_DIR   = $(BUILD_DIR)/fuzz
$(FUZZ_DIR)/json_fuzz: test/fuzz/json_fuzz.c oci/json.c oci/json.h
	@mkdir -p '$(@D)'
	$(FUZZ_CC) $(FUZZ_FLAGS) -Ioci -o $@ $(filter %.c,$^)

$(FUZZ_DIR)/unpack_fuzz: test/fuzz/unpack_fuzz.c store/unpack.c $(wildcard store/*.h) \
                         $(BUILD_DIR)/store/store.o $(BUILD_DIR)/engine/sha256.o $(BUILD_DIR)/engine/verity.o \
                         $(BUILD_DIR)/engine/tree.o $(SEXPR_OBJS)
	@mkdir -p '$(@D)'
	$(FUZZ_CC) $(FUZZ_FLAGS) $(CPPFLAGS) -o $@ $(filter %.c %.o,$^) -lz

$(FUZZ_DIR)/media_fuzz: test/fuzz/media_fuzz.c engine/media.c engine/media.h engine/sha256.c
	@mkdir -p $(dir $@)
	$(FUZZ_CC) $(FUZZ_FLAGS) -Iengine -o $@ $(filter %.c,$^)

$(FUZZ_DIR)/pack_fuzz: test/fuzz/pack_fuzz.c store/pack.c $(wildcard store/*.h) \
                       $(BUILD_DIR)/store/store.o $(BUILD_DIR)/engine/sha256.o \
                       $(BUILD_DIR)/engine/verity.o $(BUILD_DIR)/engine/tree.o $(SEXPR_OBJS)
	@mkdir -p '$(@D)'
	$(FUZZ_CC) $(FUZZ_FLAGS) $(CPPFLAGS) -o $@ $(filter %.c %.o,$^) -lzstd -lz

$(FUZZ_DIR)/import_fuzz: test/fuzz/import_fuzz.c cli/import.c cli/import.h engine/user.c engine/user.h
	@mkdir -p $(dir $@)
	$(FUZZ_CC) $(FUZZ_FLAGS) -Icli -Iengine -o $@ $(filter %.c,$^)

$(FUZZ_DIR)/spec_fuzz: test/fuzz/spec_fuzz.c spec/spec.c spec/spec.h sexpr/sexpr.c sexpr/sexpr.h \
                       $(GEN_DIR)/readable.c $(GEN_DIR)/canonical.c $(SITU_DIR)/runtime/c/situ.c
	@mkdir -p $(dir $@)
	$(FUZZ_CC) $(FUZZ_FLAGS) $(CPPFLAGS) -o $@ $(filter %.c,$^)

check-fuzz: $(FUZZ_DIR)/json_fuzz $(FUZZ_DIR)/unpack_fuzz $(FUZZ_DIR)/media_fuzz $(FUZZ_DIR)/import_fuzz \
            $(FUZZ_DIR)/spec_fuzz $(FUZZ_DIR)/pack_fuzz $(HULL)
	$(PYTHON) test/fuzz/seeds.py '$(FUZZ_DIR)/corpus' '$(HULL)'
	mkdir -p '$(FUZZ_DIR)/work' '$(FUZZ_DIR)/found'
	cd '$(FUZZ_DIR)/found' && ../json_fuzz -max_total_time=$(FUZZ_TIME) -max_len=4096 \
		../corpus/json
	cd '$(FUZZ_DIR)/found' && FUZZ_DIR='$(abspath $(FUZZ_DIR))' ../unpack_fuzz \
		-max_total_time=$(FUZZ_TIME) -max_len=8192 -timeout=10 ../corpus/tar
	cd '$(FUZZ_DIR)/found' && FUZZ_DIR='$(abspath $(FUZZ_DIR))' ../media_fuzz \
		-max_total_time=$(FUZZ_TIME) -max_len=65536 -timeout=10 ../corpus/disc
	cd '$(FUZZ_DIR)/found' && FUZZ_DIR='$(abspath $(FUZZ_DIR))' ../import_fuzz \
		-max_total_time=$(FUZZ_TIME) -max_len=8192 -timeout=10 ../corpus/import
	cd '$(FUZZ_DIR)/found' && ../spec_fuzz -max_total_time=$(FUZZ_TIME) -max_len=8192 -timeout=10 \
		../corpus/spec
	cd '$(FUZZ_DIR)/found' && ../pack_fuzz -max_total_time=$(FUZZ_TIME) -max_len=8192 -timeout=10 \
		../corpus/pack

