// The core protocol's messages (project.md section 4.10): what a frontend
// and the per-user core say to each other, in the body of each frame of
// agent/message.situ -- the same u32 length and one canonical s-expression
// as the guest agent's, at most 1 MiB.
//
// Spelled as agent/protocol.situ spells the agent's: a message is
// `(type (ch n) ...)` with its entries sorted bytewise by key (A.1), a
// required entry is its fixed opening bytes, and the type is chosen by the
// four bytes after the `(`, which differ for every type in one direction.
// Channel 0 is control; a frontend allocates every other, one per request,
// and the core answers on the request's channel.
//
// Numbers are atoms, minimal decimal by the core's check (situ finding 13).

target buffer;
endian big;

import "../sexpr/canonical.situ";

const HELLO    = ('5' << 24) | (':' << 16) | ('h' << 8) | 'e';
const RUN      = ('3' << 24) | (':' << 16) | ('r' << 8) | 'u';
const ATTACH   = ('6' << 24) | (':' << 16) | ('a' << 8) | 't';
const LOGS     = ('4' << 24) | (':' << 16) | ('l' << 8) | 'o';
const STOP     = ('4' << 24) | (':' << 16) | ('s' << 8) | 't';
const LIST     = ('4' << 24) | (':' << 16) | ('l' << 8) | 'i';
const EXEC     = ('4' << 24) | (':' << 16) | ('e' << 8) | 'x';
const WINCH    = ('5' << 24) | (':' << 16) | ('w' << 8) | 'i';
const SIGNAL   = ('6' << 24) | (':' << 16) | ('s' << 8) | 'i';
const KILL     = ('4' << 24) | (':' << 16) | ('k' << 8) | 'i';
const STATS    = ('5' << 24) | (':' << 16) | ('s' << 8) | 't';  // both ways
const GC       = ('2' << 24) | (':' << 16) | ('g' << 8) | 'c';
const DIAL     = ('4' << 24) | (':' << 16) | ('d' << 8) | 'i';
const SEGMENT  = ('7' << 24) | (':' << 16) | ('s' << 8) | 'e';
const PAUSE    = ('5' << 24) | (':' << 16) | ('p' << 8) | 'a';
const UNPAUSE  = ('7' << 24) | (':' << 16) | ('u' << 8) | 'n';
const IMPAIR   = ('6' << 24) | (':' << 16) | ('i' << 8) | 'm';
const STARTED  = ('7' << 24) | (':' << 16) | ('s' << 8) | 't';
const DATA     = ('4' << 24) | (':' << 16) | ('d' << 8) | 'a';
const EXITED   = ('6' << 24) | (':' << 16) | ('e' << 8) | 'x';
const EOF      = ('3' << 24) | (':' << 16) | ('e' << 8) | 'o';
const MACHINES = ('8' << 24) | (':' << 16) | ('m' << 8) | 'a';
const DONE     = ('4' << 24) | (':' << 16) | ('d' << 8) | 'o';
const CREDIT   = ('6' << 24) | (':' << 16) | ('c' << 8) | 'r';
const LOST     = ('4' << 24) | (':' << 16) | ('l' << 8) | 'o';  // LOGS's, the other way
const ERROR    = ('5' << 24) | (':' << 16) | ('e' << 8) | 'r';
const PORTS    = ('5' << 24) | (':' << 16) | ('p' << 8) | 'o';

// --- what a frontend sends ----------------------------------------------------

struct client_message {
	u8  open  [must_eq = '('];
	peek u32  type;
	variant body switch (type) {
		case HELLO:   client_hello  hello;
		case RUN:     run           run;
		case ATTACH:  attach        attach;
		case LOGS:    logs          logs;
		case STOP:    stop          stop;
		case LIST:    listing       list;
		case EXEC:    exec          exec;
		case WINCH:   winch         winch;
		case SIGNAL:  signal        signal;
		case KILL:    kill          kill;
		case STATS:   stats         stats;
		case GC:      gc            gc;
		case DIAL:    dial          dial;
		case PAUSE:   pause         pause;
		case UNPAUSE: unpause       unpause;
		case SEGMENT: segment       segment;
		case IMPAIR:  impair        impair;
		case DATA:    client_data   data;
		case EOF:     eof           eof;
		case CREDIT:  credit        credit;
		default:      unknown       unknown;
	}
}

// The protocol version the frontend speaks; the core answers with its own.
struct client_hello {
	preamble u8[7] = "5:hello";
	control  ch;
	preamble u8[8] = "(5:proto";
	atom  proto;
	preamble u8[2] = "))";
}

// Run a machine: its id, and the plan the frontend made for it (section
// 4.7), `(plan (base ...)? (class ...) (machine ...))`, whole. The core
// answers `started` or `error`, then the machine's output and its exit on
// this channel for as long as the frontend stays.
//
// A machine with `(secrets ...)` (J.3) has their values after the plan,
// `(secrets (NAME VALUE) ...)`: the frontend resolves them, as the user
// and on the user's terminal, where a command asked for one may prompt,
// and the core materialises them; the core checks that they are the ones
// the plan names.
struct run {
	preamble u8[5] = "3:run";
	channel        ch;
	machine_entry  machine;
	preamble u8[7] = "(4:plan";
	form  entries[]  until ")";
	peek u8  after_plan;
	variant extra switch (after_plan) {
		case '(':  secrets_entry  has_secrets;
		default:   absent         no_secrets;
	}
	u8  close  [must_eq = ')'];
}

struct secrets_entry {
	preamble u8[10] = "(7:secrets";
	form  values[]  until ")";
}

struct absent {
}

// A running machine's output and exit, from now on, on this channel.
struct attach {
	preamble u8[8] = "6:attach";
	channel        ch;
	machine_entry  machine;
	u8  close  [must_eq = ')'];
}

// What the machine has written, kept by the core; then `eof`, or with
// `(follow true)` what it writes next, as `attach` would give.
struct logs {
	preamble u8[6] = "4:logs";
	channel        ch;
	follow_entry   follow;
	machine_entry  machine;
	u8  close  [must_eq = ')'];
}

// SIGTERM, then SIGKILL after the timeout; answered `done` once it is
// gone.
struct stop {
	preamble u8[6] = "4:stop";
	channel        ch;
	machine_entry  machine;
	preamble u8[14] = "(10:timeout_ms";
	atom  milliseconds;
	preamble u8[2] = "))";
}

// The machines the core holds, answered `machines`.
struct listing {
	preamble u8[6] = "4:list";
	channel  ch;
	u8  close  [must_eq = ')'];
}

// Reclaim what the engines keep that nothing wants (project.md section
// 4.10): each engine's report as `data`, its failure on fd 2, then
// `done`.
struct gc {
	preamble u8[4] = "2:gc";
	channel  ch;
	u8  close  [must_eq = ')'];
}

// A connection to one of a running machine's own ports, declared or not,
// on a channel of its own (project.md section 8.1): answered as an exec
// is, `started`, its bytes as `data` on fd 1 and `credit` both ways, the
// frontend's `eof` its half-close, and `exited` 0 once the machine's end
// closes. `signal` resets it.
struct dial {
	preamble u8[6] = "4:dial";
	channel        ch;
	machine_entry  machine;
	preamble u8[7] = "(4:port";
	atom  port;
	preamble u8[2] = "))";
}

// A command in a running machine, on a channel of its own: its stdin is
// `data` on fd 0 and `eof` from the frontend, its output `data` on 1 and 2
// and its end `exited` from the core, as for a machine; the core answers
// `started` once it runs. `(tty (cols n) (rows n))` runs it on a terminal
// of its own, of that size, whose output is all fd 1; `(tty false)` on
// pipes. B.3 says `(tty true)` and sends the size after, which a command
// that reads its size at once would miss.
struct exec {
	preamble u8[6] = "4:exec";
	argv_entry     argv;
	channel        ch;
	machine_entry  machine;
	preamble u8[6] = "(3:tty";
	peek u8  kind;
	variant value switch (kind) {
		case '(':  window  size;
		case '5':  no      off;
		default:   error;
	}
	preamble u8[2] = "))";
}

// An exec's terminal has this size now, as B.3's.
struct winch {
	preamble u8[7] = "5:winch";
	channel  ch;
	window   size;
	u8  close  [must_eq = ')'];
}

// A terminal's size, in characters.
struct window {
	preamble u8[7] = "(4:cols";
	atom  cols;
	preamble u8[8] = ")(4:rows";
	atom  rows;
	u8  close  [must_eq = ')'];
}

// A signal for an exec, by name without its SIG: HUP, INT, QUIT, TERM,
// USR1, USR2 or KILL, which the core checks.
struct signal {
	preamble u8[8] = "6:signal";
	channel  ch;
	preamble u8[9] = "(6:signal";
	atom  name;
	preamble u8[2] = "))";
}

// A signal for a machine's workload, rather than for a command in it;
// answered `done` once it is sent, not once the workload acts on it.
struct kill {
	preamble u8[6] = "4:kill";
	channel        ch;
	machine_entry  machine;
	preamble u8[9] = "(6:signal";
	atom  name;
	preamble u8[2] = "))";
}

// What the host spends on a running machine, answered `measured`.
struct stats {
	preamble u8[7] = "5:stats";
	channel        ch;
	machine_entry  machine;
	u8  close  [must_eq = ')'];
}

// Every process of a running machine stopped where it is, a peer gone to
// sleep; answered `done`. `unpause` lets it go on.
struct pause {
	preamble u8[7] = "5:pause";
	channel        ch;
	machine_entry  machine;
	u8  close  [must_eq = ')'];
}

struct unpause {
	preamble u8[9] = "7:unpause";
	channel        ch;
	machine_entry  machine;
	u8  close  [must_eq = ')'];
}

// A segment's ports and what each has counted, each way, answered
// `ports` (project.md Appendix D).
struct segment {
	preamble u8[9] = "7:segment";
	channel  ch;
	preamble u8[7] = "(4:name";
	atom  name;
	preamble u8[2] = "))";
}

// One direction, `in` or `out`, of the ports a machine has on a segment,
// or every machine's where the machine is `*`, given an impairment in
// netem's terms, replacing what it had; answered `done`. Its entries are
// `(key value)`, and `(gemodel (bad_loss n) (good_loss n) (p n) (r n))`, as
// the spec writes them, which the core checks.
struct impair {
	preamble u8[8] = "6:impair";
	channel        ch;
	preamble u8[12] = "(9:direction";
	atom  direction;
	preamble u8[15] = ")(10:impairment";
	form  entries[]  until ")";
	machine_entry  machine;
	preamble u8[7] = "(4:name";
	atom  name;
	preamble u8[2] = "))";
}

// An exec's stdin: always fd 0.
struct client_data {
	preamble u8[12] = "4:data(3:buf";
	atom     bytes;
	u8       close_buf  [must_eq = ')'];
	channel  ch;
	preamble u8[10] = "(2:fd1:0))";
}

// `(follow true)` or `(follow false)`.
struct follow_entry {
	preamble u8[9] = "(6:follow";
	peek u8  length;
	variant value switch (length) {
		case '4':  yes  on;
		case '5':  no   off;
		default:   error;
	}
	u8  close  [must_eq = ')'];
}

struct yes { preamble u8[6] = "4:true"; }
struct no  { preamble u8[7] = "5:false"; }

// --- what the core sends ------------------------------------------------------

struct core_message {
	u8  open  [must_eq = '('];
	peek u32  type;
	variant body switch (type) {
		case HELLO:     core_hello  hello;
		case STARTED:   started     started;
		case DATA:      data        data;
		case EXITED:    exited      exited;
		case EOF:       eof         eof;
		case MACHINES:  machines    machines;
		case DONE:      done        done;
		case CREDIT:    credit      credit;
		case LOST:      lost        lost;
		case STATS:     measured    stats;
		case PORTS:     ports       ports;
		case ERROR:     failure     error;
		default:        unknown     unknown;
	}
}

struct core_hello {
	preamble u8[7] = "5:hello";
	control  ch;
	preamble u8[16] = "(12:core_version";
	atom  version;
	preamble u8[9] = ")(5:proto";
	atom  proto;
	preamble u8[2] = "))";
}

struct started {
	preamble u8[9] = "7:started";
	channel        ch;
	machine_entry  machine;
	u8  close  [must_eq = ')'];
}

// stdout or stderr: fd 1 or 2.
struct data {
	preamble u8[12] = "4:data(3:buf";
	atom     bytes;
	u8       close_buf  [must_eq = ')'];
	channel  ch;
	preamble u8[7] = "(2:fd1:";
	decimal u8  fd[1]  [min = 1, max = 2];
	preamble u8[2] = "))";
}

// As B.3's: an exit code, and the signal that ended it or 0.
struct exited {
	preamble u8[8] = "6:exited";
	channel  ch;
	preamble u8[7] = "(4:code";
	atom  code;
	preamble u8[10] = ")(6:signal";
	atom  signal;
	preamble u8[2] = "))";
}

// B.2's credit, for an exec, in both directions. From the core: more of
// the exec's stdin it will take. An exec starts with none, and the
// frontend sends no more than it has been given; the core gives back
// what reached the command. From the frontend: more of the command's
// output it will take, given back as it is written out. An exec's
// output starts with 65536 bytes of credit, so a frontend that never
// gives any still sees the start of it.
struct credit {
	preamble u8[16] = "6:credit(5:bytes";
	atom  bytes;
	u8    close_bytes  [must_eq = ')'];
	channel  ch;
	u8  close  [must_eq = ')'];
}

// What a follower of a machine's output -- `run`, `attach`, `logs` -- fell
// so far behind that it left the core's log before it was read: so many
// bytes, between the data before this and the data after. The machine is
// never held back for a follower.
struct lost {
	preamble u8[14] = "4:lost(5:bytes";
	atom  bytes;
	u8    close_bytes  [must_eq = ')'];
	channel  ch;
	u8  close  [must_eq = ')'];
}

// The end of what `logs` replays, when it does not follow; from a
// frontend, the end of an exec's stdin.
struct eof {
	preamble u8[5] = "3:eof";
	channel  ch;
	u8  close  [must_eq = ')'];
}

struct machines {
	preamble u8[10] = "8:machines";
	channel  ch;
	listed   items[]  until ")";
}

// One machine of `machines`.
struct listed {
	preamble u8[20] = "(7:machine(7:address";
	atom  address;
	preamble u8[9] = ")(5:class";
	atom  class;
	preamble u8[10] = ")(6:engine";
	atom  engine;
	preamble u8[6] = ")(2:id";
	atom  id;
	preamble u8[9] = ")(5:state";
	atom  state;
	preamble u8[2] = "))";
}

// `stats`' answer, as the machine's engine measures it from the host:
// microseconds of CPU time, bytes read from and written to storage, and
// bytes resident by Pss, counting every process of the machine's and
// those it has reaped.
struct measured {
	preamble u8[7] = "5:stats";
	channel  ch;
	preamble u8[6] = "(3:cpu";
	atom  cpu;
	preamble u8[6] = ")(2:io";
	atom  io;
	preamble u8[10] = ")(6:memory";
	atom  memory;
	preamble u8[2] = "))";
}

// `segment`'s answer: each port, its machine, and its counts out and in.
struct ports {
	preamble u8[7] = "5:ports";
	channel  ch;
	form     items[]  until ")";
}

// A request carried out, where there is nothing more to say: `stop`.
struct done {
	preamble u8[6] = "4:done";
	channel  ch;
	u8  close  [must_eq = ')'];
}

// A refusal, on the channel of what was refused; `unsupported` answers a
// type the core does not know.
struct failure {
	preamble u8[7] = "5:error";
	channel  ch;
	preamble u8[9] = "(6:reason";
	atom  reason;
	preamble u8[2] = "))";
}

// --- both ways ----------------------------------------------------------------

// A type this side does not know, framed whole so that it can be answered.
struct unknown {
	atom  type;
	form  entries[]  until ")";
}

// --- entries -----------------------------------------------------------------

struct control {
	preamble u8[9] = "(2:ch1:0)";
}

struct channel {
	preamble u8[5] = "(2:ch";
	atom  id;
	u8    close  [must_eq = ')'];
}

// The words of an exec's command: at least one, which the core checks.
struct argv_entry {
	preamble u8[7] = "(4:argv";
	atom  words[]  until ")";
}

struct machine_entry {
	preamble u8[10] = "(7:machine";
	atom  id;
	u8    close  [must_eq = ')'];
}

// ---------------------------------------------------------------------------
//
// WHAT THIS SCHEMA DOES NOT SAY, and the core and frontends check instead:
//
// - that a request's channel is not 0 and not already in use, and that
//   `data` and `eof` from a frontend are on an exec's channel;
// - that an exec's argv holds a word, that a window's size is in range,
//   and that a signal is one the core forwards;
// - that a machine id is a DNS label (section 4.10), and a plan one
//   hull_plan_build() would write;
// - that the numbers are minimal decimal;
// - an impairment's entries and each port of `ports`, which situ frames
//   and does not read, and that a direction is in or out;
// - the elements of a run -- each `listed` of `machines`, the plan's
//   entries in `run` -- which situ frames and does not read.
