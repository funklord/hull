// What hull at a segment's .1 reads from a machine and writes back
// (project.md Appendix D): an Ethernet frame's header, ARP for IPv4, an
// IPv4 header, a UDP datagram, a TCP segment, an ICMP echo, and a DNS
// message's header; and for a segment's IPv6 network, hull at its ::1,
// an IPv6 header, ICMPv6's echo, its neighbour solicitation and
// advertisement, and its router solicitation and advertisement.
// Every frame core/segment.c answers comes from a machine on the segment,
// which is to say from whatever runs in it, so this is where hull reads
// bytes it did not write; each is validated here, checksums included,
// before the switch looks at a field. The structures follow situ's own
// example/ethernet, arp, ipv4, udp, tcp and dns, which say why each is so.

codec internet_checksum {
	kernel = ones_complement(width = 16, complement);
}

// UDP's own, RFC 768: a computed zero is sent as all ones, a zero in the
// field meaning the sender computed none, which a stored zero is read as.
codec udp_checksum {
	kernel = ones_complement(width = 16, complement, zero_means_none);
}

impl internet_checksum derived;
impl udp_checksum derived;

target buffer;
endian big;
bit_order msb_first;

// The frame's first 14 bytes. Its type is a number, not an enum: the
// switch carries every type and .1 answers two.
struct ethernet_header {
	u8   destination[6];
	u8   source[6];
	u16  ethertype;
}

require size(ethernet_header) == 14;

enum arp_operation : u16 {
	request = 1,
	reply   = 2,
}

// ARP for IPv4 over Ethernet, RFC 826 with its lengths fixed: the only
// ARP .1 answers, a request for its own address.
struct arp_packet {
	u16            hardware_type    [must_eq = 1];
	u16            protocol_type    [must_eq = 0x0800];
	u8             hardware_length  [must_eq = 6];
	u8             protocol_length  [must_eq = 4];
	arp_operation  operation;
	u8             sender_hardware[6];
	u32            sender_protocol;
	u8             target_hardware[6];
	u32            target_protocol;
}

require size(arp_packet) == 28;

// An IPv4 header, RFC 791, its options included and its sum checked; the
// payload after it is the datagram's total length less this.
struct ipv4_header [allow_straddle] {
	authenticated header {
		u4        version          [must_eq = 4];
		u4        ihl              [min = 5];
		u6        dscp;
		u2        ecn;
		u16       total_length;
		u16       identification;
		reserved  bit              [must_be_zero];
		bit       dont_fragment;
		bit       more_fragments;
		u13       fragment_offset;
		u8        time_to_live;
		u8        protocol;
		checksum u8 header_checksum[2] covers(header) is internet_checksum
			[self_as = 0];
		u32       source;
		u32       destination;
		u8        options[(ihl - 5) * 4];
	}
}

require offset(ipv4_header.options) == 20;

// The sum UDP and TCP take over their own bytes is taken over these first
// (RFC 768, RFC 9293 3.1). Over IPv6 their pseudo-header is 40 bytes
// (RFC 8200 8.1), and ICMPv6 takes one too; it is given here folded into
// these 12 -- its ones' complement sum in the first two bytes, the rest
// zero -- since a ones' complement sum is its words' sum alone, wherever
// they sit, so that UDP's and TCP's structures serve both families.
struct pseudo_header {
	u32  source_address;
	u32  destination_address;
	u8   zero        [must_eq = 0];
	u8   protocol;
	u16  length;
}

require size(pseudo_header) == 12;

// A UDP datagram, RFC 768, its sum udp_checksum: a stored 0 is a datagram
// sent with none, which IPv4 allows and the codec accepts, and a sum that
// computes to 0 is written as all ones.
struct udp_datagram {
	authenticated summed {
		u16  source_port;
		u16  destination_port;
		u16  length  [min = 8];
		checksum u8 checksum[2] covers(summed) prefix(pseudo_header)
			is udp_checksum [self_as = 0];
		u8   payload[length - 8];
	}
}

require offset(udp_datagram.payload) == 8;

// A TCP segment, RFC 9293, its options and its payload.
struct tcp_segment {
	authenticated summed {
		u16       source_port;
		u16       destination_port;
		u32       sequence;
		u32       acknowledgement;
		u4        data_offset  [min = 5];
		reserved  u4           [must_be_zero];
		bit       cwr;
		bit       ece;
		bit       urgent;
		bit       ack;
		bit       push;
		bit       reset;
		bit       syn;
		bit       fin;
		u16       window;
		checksum  u8 checksum[2] covers(summed) prefix(pseudo_header)
			is internet_checksum [self_as = 0];
		u16       urgent_pointer;
		u8        options[(data_offset - 5) * 4];
		u8        payload[remaining];
	}
}

require offset(tcp_segment.options) == 20;

// An ICMP echo request or reply, RFC 792: its sum over the whole message,
// with no pseudo-header, and the data echoed back as it came.
struct icmp_echo {
	authenticated summed {
		u8        type;
		u8        code        [must_eq = 0];
		checksum  u8 checksum[2] covers(summed) is internet_checksum
			[self_as = 0];
		u16       identifier;
		u16       sequence;
		u8        data[remaining];
	}
}

require offset(icmp_echo.data) == 8;

// An IPv6 header, RFC 8200, with no extension header after it: .1 reads
// none, a datagram with one being not one it answers.
struct ipv6_header [allow_straddle] {
	u4   version         [must_eq = 6];
	u4   traffic_high;   // the traffic class, which spans the version's byte
	u4   traffic_low;
	u20  flow_label;
	u16  payload_length;
	u8   next_header;
	u8   hop_limit;
	u8   source[16];
	u8   destination[16];
}

require size(ipv6_header) == 40;

// ICMPv6's echo request or reply, RFC 4443 4: as ICMP's, its sum over a
// pseudo-header first.
struct icmp6_echo {
	authenticated summed {
		u8        type;
		u8        code        [must_eq = 0];
		checksum  u8 checksum[2] covers(summed) prefix(pseudo_header)
			is internet_checksum [self_as = 0];
		u16       identifier;
		u16       sequence;
		u8        data[remaining];
	}
}

// A neighbour solicitation, RFC 4861 4.3, which a machine sends to learn
// hull's MAC for ::1 as it sends ARP for .1; its options are read in C.
struct neighbor_solicitation {
	authenticated summed {
		u8        type        [must_eq = 135];
		u8        code        [must_eq = 0];
		checksum  u8 checksum[2] covers(summed) prefix(pseudo_header)
			is internet_checksum [self_as = 0];
		u32       unused;
		u8        target[16];
		u8        options[remaining];
	}
}

// hull's answer, RFC 4861 4.4: solicited, overriding, its MAC the target
// link-layer address option.
struct neighbor_advertisement [allow_straddle] {
	authenticated summed {
		u8        type        [must_eq = 136];
		u8        code        [must_eq = 0];
		checksum  u8 checksum[2] covers(summed) prefix(pseudo_header)
			is internet_checksum [self_as = 0];
		bit       router;
		bit       solicited;
		bit       override;
		reserved  u29         [must_be_zero];
		u8        target[16];
		u8        options[remaining];
	}
}

// A router solicitation, RFC 4861 4.1, which a machine's kernel sends as
// its interface comes up, asking for an advertisement at once.
struct router_solicitation {
	authenticated summed {
		u8        type        [must_eq = 133];
		u8        code        [must_eq = 0];
		checksum  u8 checksum[2] covers(summed) prefix(pseudo_header)
			is internet_checksum [self_as = 0];
		u32       unused;
		u8        options[remaining];
	}
}

// hull's router advertisement, RFC 4861 4.2, where a segment asks it to
// advertise its IPv6 network: the hop limit to use, neither managed nor
// other configuration, and a router lifetime of 0 -- hull is no gateway,
// and a machine's default route stays its own; the prefix, RDNSS and DNSSL
// are its options, built in C.
struct router_advertisement [allow_straddle] {
	authenticated summed {
		u8        type        [must_eq = 134];
		u8        code        [must_eq = 0];
		checksum  u8 checksum[2] covers(summed) prefix(pseudo_header)
			is internet_checksum [self_as = 0];
		u8        hop_limit;
		bit       managed;
		bit       other;
		reserved  u6          [must_be_zero];
		u16       router_lifetime;
		u32       reachable_time;
		u32       retransmit_timer;
		u8        options[remaining];
	}
}

// A DNS message's twelve bytes of header, RFC 1035 4.1.1 with RFC 2535's
// and RFC 4035's two bits; the question after it is segment.c's to read.
struct dns_header {
	u16       id;
	bit       is_response;
	u4        opcode;
	bit       authoritative;
	bit       truncated;
	bit       recursion_desired;
	bit       recursion_available;
	reserved  u1    [must_be_zero];
	bit       authentic_data;
	bit       checking_disabled;
	u4        response_code;
	u16       question_count;
	u16       answer_count;
	u16       authority_count;
	u16       additional_count;
}

require size(dns_header) == 12;
